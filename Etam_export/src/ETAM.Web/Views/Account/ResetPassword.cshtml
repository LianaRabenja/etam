@model ETAM.Web.Models.ResetPasswordViewModel
@{ ViewData["Title"] = "Réinitialiser le mot de passe"; }
<form asp-action="ResetPassword" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
    <input type="hidden" asp-for="Email" />
    <input type="hidden" asp-for="Token" />
    <div class="mb-3">
        <label class="form-label" asp-for="Password"></label>
        <input asp-for="Password" class="form-control" />
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" asp-for="ConfirmPassword"></label>
        <input asp-for="ConfirmPassword" class="form-control" />
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>
    <button type="submit" class="btn btn-primary w-100">Réinitialiser</button>
    <a asp-action="Login" class="btn btn-link w-100 mt-2">Retour à la connexion</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
