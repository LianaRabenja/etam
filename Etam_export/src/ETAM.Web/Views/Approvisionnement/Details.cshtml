@model ETAM.Domain.Entities.Approvisionnement
@{ ViewData["Title"] = $"Approvisionnement {Model.Reference}"; }
<div class="etam-card p-4">
    <div class="d-flex justify-content-between">
        <h5 class="fw-bold">@Model.Reference</h5>
        <div>
            @if (Model.Statut == ETAM.Domain.Enums.StatutApprovisionnement.Brouillon
                 && (User.IsInRole("Administrateur") || User.IsInRole("Chef de chantier")))
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-light"><i class="fa-solid fa-pen me-1"></i> Modifier</a>
            }
            <span class="badge bg-secondary align-self-start">@Model.Statut</span>
        </div>
    </div>
    <p class="text-muted mb-3">Chantier : <strong>@Model.Chantier?.Nom</strong> · @Model.DateAppro.ToString("dd/MM/yyyy")</p>
    <table class="table table-sm align-middle">
        <thead><tr><th>Désignation</th><th>Catégorie</th><th>Type</th><th class="text-end">Qté</th><th class="text-end">P.U.</th><th class="text-end">Total</th></tr></thead>
        <tbody>
        @foreach (var l in Model.Lignes)
        {
            <tr>
                <td>@l.Designation</td><td class="small text-muted">@l.Categorie</td>
                <td><span class="badge @(l.TypeBudget == ETAM.Domain.Enums.TypeBudget.Compte ? "bg-primary" : "bg-success")">@l.TypeBudget</span></td>
                <td class="text-end">@l.Quantite.ToString("N2")</td>
                <td class="text-end">@l.PrixUnitaireEstime.ToString("N0")</td>
                <td class="text-end fw-semibold">@l.Total.ToString("N0")</td>
            </tr>
        }
        </tbody>
        <tfoot><tr><th colspan="5" class="text-end">Total</th><th class="text-end">@Model.Total.ToString("N0") Ar</th></tr></tfoot>
    </table>
    @if (!string.IsNullOrEmpty(Model.Observation)) { <p class="small text-muted">@Model.Observation</p> }
    @if (Model.PrevisionJournaliereId != null)
    {
        <a asp-controller="Prevision" asp-action="Details" asp-route-id="@Model.PrevisionJournaliereId" class="btn btn-sm btn-primary">Voir la prévision générée</a>
    }
</div>

@if (Model.Statut == ETAM.Domain.Enums.StatutApprovisionnement.Brouillon
     && (User.IsInRole("Administrateur") || User.IsInRole("Correspondant")))
{
    <div class="etam-card p-4 mt-3">
        <h6 class="fw-bold mb-2">Validation (Responsable)</h6>
        <p class="small text-muted">Après vérification des lignes ci-dessus, validez pour générer la prévision (elle sera ensuite soumise à l'Administrateur).</p>
        <form asp-action="Convertir" method="post" class="js-convert">
            @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
            <button type="button" class="btn btn-success"><i class="fa-solid fa-right-to-bracket me-1"></i> Valider → générer la prévision</button>
        </form>
    </div>
}

<a asp-action="Index" class="btn btn-light mt-3">Retour</a>

@section Scripts {
<script>
  document.querySelectorAll('.js-convert').forEach(f=>{
    f.querySelector('button').addEventListener('click',()=>{
      Swal.fire({title:'Valider cet approvisionnement ?',text:'Il sera converti en prévision et soumis pour validation.',
        icon:'question',showCancelButton:true,confirmButtonText:'Valider',cancelButtonText:'Annuler',confirmButtonColor:'#059669'})
        .then(r=>{ if(r.isConfirmed) f.submit(); });
    });
  });
</script>
}
