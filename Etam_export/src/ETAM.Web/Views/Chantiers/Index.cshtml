@model List<ETAM.Application.DTOs.ChantierDto>
@{ ViewData["Title"] = "Chantiers"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">@Model.Count chantier(s)</p>
    @if (User.IsInRole("Administrateur") || User.IsInRole("Correspondant"))
    {
        <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i> Nouveau chantier</a>
    }
</div>
<div class="etam-card p-3">
<table class="table table-hover align-middle datatable">
    <thead><tr>
        <th>Code</th><th>Nom</th><th>Localisation</th><th>Statut</th>
        <th class="text-end">Budget Matériel</th><th class="text-end">Consommation</th>
        <th class="text-end">Réserve restante</th>
        <th style="width:140px">Avancement</th><th></th>
    </tr></thead>
    <tbody>
    @foreach (var c in Model)
    {
        var badge = c.Statut switch {
            StatutChantier.EnCours => "bg-primary",
            StatutChantier.Termine => "bg-success",
            StatutChantier.Suspendu => "bg-warning text-dark",
            StatutChantier.Cloture => "bg-secondary",
            _ => "bg-info text-dark" };
        <tr>
            <td><span class="fw-semibold">@c.Code</span></td>
            <td>@c.Nom</td>
            <td class="text-muted small">@c.Localisation</td>
            <td><span class="badge badge-statut @badge">@c.Statut</span></td>
            <td class="text-end">@c.BudgetMateriel.ToString("N0")</td>
            <td class="text-end">@c.Consommation.ToString("N0")</td>
            <td class="text-end fw-semibold">@c.ReserveRestante.ToString("N0")</td>
            <td>
                <div class="etam-progress"><span style="width:@c.PourcentageAvancement%"></span></div>
                <div class="small text-muted">@c.PourcentageAvancement%</div>
            </td>
            <td class="text-end text-nowrap">
                <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-light" title="Détails"><i class="fa-solid fa-eye"></i></a>
                @if (User.IsInRole("Administrateur") || User.IsInRole("Correspondant"))
                {
                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-light" title="Modifier"><i class="fa-solid fa-pen"></i></a>
                }
                @if (User.IsInRole("Administrateur"))
                {
                    <form asp-action="Delete" asp-route-id="@c.Id" method="post" class="d-inline js-del-chantier">
                        @Html.AntiForgeryToken()
                        <button type="button" class="btn btn-sm btn-light text-danger" title="Supprimer"><i class="fa-solid fa-trash"></i></button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
@section Scripts {
<script>
  document.querySelectorAll('.js-del-chantier').forEach(f=>{
    f.querySelector('button').addEventListener('click',()=>{
      Swal.fire({title:'Supprimer ce chantier ?',text:'Cette action est réversible (suppression logique).',
        icon:'warning',showCancelButton:true,confirmButtonText:'Supprimer',cancelButtonText:'Annuler',confirmButtonColor:'#dc2626'})
        .then(r=>{ if(r.isConfirmed) f.submit(); });
    });
  });
</script>
}
