@model List<ETAM.Domain.Entities.Depense>
@{ ViewData["Title"] = "Dépenses"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">@Model.Count dépense(s) — total @Model.Sum(d => d.Montant).ToString("N0") Ar</p>
    @if (User.IsInRole("Administrateur") || User.IsInRole("Correspondant") || User.IsInRole("Chef de chantier"))
    {
        <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i> Nouvelle dépense</a>
    }
</div>
<div class="etam-card p-3">
<table class="table table-hover align-middle datatable">
    <thead><tr>
        <th>Date</th><th>Chantier</th><th>Désignation</th><th>Catégorie</th>
        <th>Budget</th><th class="text-end">Quantité</th><th class="text-end">P.U.</th><th class="text-end">Montant</th>
    </tr></thead>
    <tbody>
    @foreach (var d in Model)
    {
        <tr>
            <td>@d.Date.ToString("dd/MM/yyyy")</td>
            <td class="small">@d.Chantier?.Nom</td>
            <td class="fw-semibold">@d.Designation</td>
            <td class="small text-muted">@d.Categorie</td>
            <td><span class="badge @(d.BudgetConcerne == ETAM.Domain.Enums.TypeBudget.Compte ? "bg-primary" : "bg-success")">@d.BudgetConcerne</span></td>
            <td class="text-end">@d.Quantite.ToString("N2")</td>
            <td class="text-end">@d.PrixUnitaire.ToString("N0")</td>
            <td class="text-end fw-semibold">@d.Montant.ToString("N0") Ar</td>
        </tr>
    }
    </tbody>
</table>
</div>
