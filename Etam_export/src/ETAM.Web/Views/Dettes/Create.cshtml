@model ETAM.Domain.Entities.DetteFournisseur
@{ ViewData["Title"] = "Nouvelle dette";
   var fournisseurs = ViewBag.Fournisseurs as IEnumerable<ETAM.Domain.Entities.Fournisseur>;
   var chantiers = ViewBag.Chantiers as IEnumerable<ETAM.Domain.Entities.Chantier>; }
<div class="etam-card p-4" style="max-width:640px">
<form asp-action="Create" method="post">
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label">Fournisseur</label>
            <select asp-for="FournisseurId" class="form-select" required>
                <option value="">-- choisir --</option>
                @foreach (var f in fournisseurs ?? Enumerable.Empty<ETAM.Domain.Entities.Fournisseur>())
                { <option value="@f.Id">@f.Nom</option> }
            </select></div>
        <div class="col-md-6"><label class="form-label">Chantier (option)</label>
            <select asp-for="ChantierId" class="form-select">
                <option value="">—</option>
                @foreach (var c in chantiers ?? Enumerable.Empty<ETAM.Domain.Entities.Chantier>())
                { <option value="@c.Id">@c.Nom</option> }
            </select></div>
        <div class="col-12"><label class="form-label">Libellé</label>
            <input asp-for="Libelle" class="form-control" placeholder="Dette ciment, dette fer..." required /></div>
        <div class="col-md-6"><label class="form-label">Montant initial (Ar)</label>
            <input asp-for="MontantInitial" type="number" step="0.01" class="form-control" required /></div>
        <div class="col-md-6"><label class="form-label">Échéance</label>
            <input asp-for="DateEcheance" type="date" class="form-control" /></div>
    </div>
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Enregistrer</button>
        <a asp-action="Index" class="btn btn-light">Annuler</a>
    </div>
</form>
</div>
