@model ETAM.Web.Models.ChangePasswordViewModel
@{ ViewData["Title"] = "Changer mon mot de passe"; }

<div class="etam-card p-4" style="max-width:520px">
    <h5 class="fw-bold mb-1">Changer mon mot de passe</h5>
    <p class="small text-muted mb-4">8 caractères minimum, avec une majuscule, un chiffre et un caractère spécial.</p>

    <form asp-action="ChangePassword" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

        <div class="mb-3">
            <label class="form-label" asp-for="AncienMotDePasse"></label>
            <input asp-for="AncienMotDePasse" type="password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="AncienMotDePasse" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="NouveauMotDePasse"></label>
            <input asp-for="NouveauMotDePasse" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NouveauMotDePasse" class="text-danger small"></span>
        </div>
        <div class="mb-4">
            <label class="form-label" asp-for="Confirmation"></label>
            <input asp-for="Confirmation" type="password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Confirmation" class="text-danger small"></span>
        </div>

        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-key me-1"></i> Modifier</button>
        <a href="/" class="btn btn-light">Annuler</a>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
