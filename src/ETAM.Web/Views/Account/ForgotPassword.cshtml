@model ETAM.Web.Models.ForgotPasswordViewModel
@{ ViewData["Title"] = "Mot de passe oublié"; }
<form asp-action="ForgotPassword" method="post">
    <p class="text-muted small">Saisissez votre email pour recevoir un lien de réinitialisation.</p>
    <div class="mb-3">
        <label class="form-label" asp-for="Email"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>
    <button type="submit" class="btn btn-primary w-100">Envoyer le lien</button>
    <a asp-action="Login" class="btn btn-link w-100 mt-2">Retour à la connexion</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
