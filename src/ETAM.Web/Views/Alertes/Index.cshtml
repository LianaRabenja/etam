@model List<ETAM.Domain.Entities.Alerte>
@{ ViewData["Title"] = "Alertes"; }
<div class="d-flex justify-content-between align-items-center mb-2">
    <p class="text-muted mb-0" id="compteurNonLues">@Model.Count(a => !a.EstLue) alerte(s) non lue(s) sur @Model.Count.</p>
    @if (Model.Any(a => !a.EstLue))
    {
        <form id="formToutesLues" asp-action="MarquerToutesLues" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-sm btn-light"><i class="fa-solid fa-check-double me-1"></i> Tout marquer comme lu</button>
        </form>
    }
</div>
<div class="etam-card p-3">
<table class="table table-hover align-middle datatable">
    <thead><tr><th>Niveau</th><th>Titre</th><th>Message</th><th>Chantier</th><th>Date</th><th></th></tr></thead>
    <tbody>
    @foreach (var a in Model)
    {
        var b = a.Niveau switch {
            ETAM.Domain.Enums.NiveauAlerte.Critique => "bg-danger",
            ETAM.Domain.Enums.NiveauAlerte.Avertissement => "bg-warning text-dark",
            _ => "bg-info text-dark" };
        <tr class="js-ligne-alerte @(a.EstLue ? "opacity-50" : "")" data-id="@a.Id">
            <td><span class="badge @b">@a.Niveau</span></td>
            <td class="fw-semibold">@a.Titre</td>
            <td class="small">@a.Message</td>
            <td class="small text-muted">@a.Chantier?.Nom</td>
            <td class="small">@a.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
            <td class="text-end">
                @if (!a.EstLue)
                {
                    <form asp-action="MarquerLue" method="post" class="d-inline js-marquer-lue">
                        @Html.AntiForgeryToken()<input type="hidden" name="id" value="@a.Id" />
                        <button class="btn btn-sm btn-light"><i class="fa-solid fa-check"></i> Lu</button></form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

@section Scripts {
<script>
  // Marquer une alerte comme lue en AJAX : pas de rechargement de page, et le badge
  // de notification dans l'en-tête diminue immédiatement.
  document.querySelectorAll('.js-marquer-lue').forEach(form => {
    form.addEventListener('submit', function(e){
      e.preventDefault();
      const token = form.querySelector('input[name="__RequestVerificationToken"]').value;
      const id = form.querySelector('input[name="id"]').value;
      const fd = new FormData();
      fd.append('__RequestVerificationToken', token);
      fd.append('id', id);
      fetch('@Url.Action("MarquerLue")', { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(r => r.json())
        .then(data => {
          if (!data.success) return;
          const tr = form.closest('tr');
          tr.classList.add('opacity-50');
          form.remove();
          window.etamSetBadgeNotif(data.restantes);
          const compteur = document.getElementById('compteurNonLues');
          if (compteur) compteur.textContent = data.restantes + ' alerte(s) non lue(s) sur @Model.Count.';
          if (data.restantes === 0) {
            const btnTout = document.querySelector('#formToutesLues');
            if (btnTout) btnTout.remove();
          }
        });
    });
  });

  const formToutesLues = document.getElementById('formToutesLues');
  if (formToutesLues) {
    formToutesLues.addEventListener('submit', function(e){
      e.preventDefault();
      const token = formToutesLues.querySelector('input[name="__RequestVerificationToken"]').value;
      const fd = new FormData();
      fd.append('__RequestVerificationToken', token);
      fetch('@Url.Action("MarquerToutesLues")', { method: 'POST', body: fd, headers: { 'X-Requested-With': 'XMLHttpRequest' } })
        .then(r => r.json())
        .then(data => {
          if (!data.success) return;
          document.querySelectorAll('.js-ligne-alerte').forEach(tr => tr.classList.add('opacity-50'));
          document.querySelectorAll('.js-marquer-lue').forEach(f => f.remove());
          window.etamSetBadgeNotif(0);
          const compteur = document.getElementById('compteurNonLues');
          if (compteur) compteur.textContent = '0 alerte(s) non lue(s) sur @Model.Count.';
          formToutesLues.remove();
        });
    });
  }
</script>
}
