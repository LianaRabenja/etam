@model List<ETAM.Domain.Entities.AuditLog>
@{ ViewData["Title"] = "Journal d'audit"; }
<p class="text-muted">@Model.Count dernière(s) action(s) tracée(s).</p>
<div class="etam-card p-3">
<table class="table table-hover align-middle datatable">
    <thead><tr><th>Date</th><th>Action</th><th>Entité</th><th>Utilisateur</th><th>IP</th><th>Détail</th></tr></thead>
    <tbody>
    @foreach (var a in Model)
    {
        <tr>
            <td class="small">@a.DateAction.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
            <td><span class="badge bg-secondary">@a.Action</span></td>
            <td class="small">@a.Entite @(string.IsNullOrEmpty(a.CleEntite) ? "" : $"#{a.CleEntite}")</td>
            <td class="small">@a.UtilisateurNom</td>
            <td class="small text-muted">@a.AdresseIp</td>
            <td class="small text-muted">@a.NouvelleValeur</td>
        </tr>
    }
    </tbody>
</table>
</div>
