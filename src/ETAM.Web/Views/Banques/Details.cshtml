@model ETAM.Domain.Entities.CompteBancaire
@{ ViewData["Title"] = $"{Model.Banque} — {Model.Nom}";
   var mvts = ViewBag.Mouvements as List<ETAM.Domain.Entities.MouvementBancaire> ?? new(); }
<div class="d-flex justify-content-between align-items-center mb-3">
    <div><span class="text-muted">Solde actuel :</span> <strong style="font-size:1.3rem">@Model.Solde.ToString("N0") @Model.Devise</strong></div>
    <div>
        @if (User.IsInRole("Administrateur") || User.IsInRole("Correspondant"))
        {
            <a asp-action="Transferer" asp-route-chantierId="@Model.ChantierId" class="btn btn-success"><i class="fa-solid fa-arrow-right-arrow-left me-1"></i> Transférer vers le budget</a>
        }
        <a asp-action="Index" class="btn btn-light">Retour</a>
    </div>
</div>
<div class="etam-card p-3">
<table class="table table-hover align-middle datatable">
    <thead><tr><th>Date</th><th>Type</th><th>Bénéficiaire / Motif</th><th>Réf.</th><th class="text-end">Montant</th></tr></thead>
    <tbody>
    @foreach (var m in mvts)
    {
        var (badge, signe) = m.Type == ETAM.Domain.Enums.TypeMouvementBancaire.Depot
            ? ("bg-success", "+") : ("bg-danger", "-");
        <tr>
            <td class="small">@m.Date.ToLocalTime().ToString("dd/MM/yyyy")</td>
            <td><span class="badge @badge">@m.Type</span></td>
            <td class="small">@m.Beneficiaire @(string.IsNullOrEmpty(m.Beneficiaire) ? "" : "· ")@m.Motif</td>
            <td class="small text-muted">@m.Reference</td>
            <td class="text-end fw-semibold @(m.Type == ETAM.Domain.Enums.TypeMouvementBancaire.Depot ? "text-success" : "text-danger")">@signe @m.Montant.ToString("N0")</td>
        </tr>
    }
    </tbody>
</table>
</div>
