@model List<ETAM.Domain.Entities.CompteBancaire>
@{
    ViewData["Title"] = "Comptes bancaires";
    var enAttente = ViewBag.TransfertsEnAttente as List<ETAM.Domain.Entities.MouvementBancaire> ?? new();
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">Trésorerie disponible : <strong>@Model.Sum(c => c.Solde).ToString("N0") Ar</strong></p>
    <div>
        @if (User.IsInRole("Administrateur") || User.IsInRole("Correspondant"))
        {
            <a asp-action="Transferer" class="btn btn-success"><i class="fa-solid fa-arrow-right-arrow-left me-1"></i> Transférer vers un budget</a>
        }
        @if (User.IsInRole("Administrateur"))
        {
            <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i> Nouveau compte</a>
        }
    </div>
</div>

@if (enAttente.Any())
{
    <div class="etam-card p-3 mb-4" style="border-left:4px solid #f59e0b">
        <h6 class="fw-bold mb-3"><i class="fa-solid fa-hourglass-half text-warning me-1"></i> Transferts en attente de validation</h6>
        <table class="table table-sm align-middle mb-0">
            <thead><tr><th>Compte</th><th>Demandé par</th><th class="text-end">Montant</th><th></th></tr></thead>
            <tbody>
            @foreach (var t in enAttente)
            {
                <tr>
                    <td>@t.CompteBancaire?.Banque — @t.CompteBancaire?.Nom</td>
                    <td class="small text-muted">@t.DemandePar</td>
                    <td class="text-end fw-semibold">@t.Montant.ToString("N0") Ar</td>
                    <td class="text-end">
                        @if (User.IsInRole("Administrateur"))
                        {
                            <form asp-action="ValiderTransfert" method="post" class="d-inline">
                                @Html.AntiForgeryToken()<input type="hidden" name="mouvementId" value="@t.Id" />
                                <button class="btn btn-sm btn-success"><i class="fa-solid fa-check"></i> Valider</button></form>
                            <form asp-action="RefuserTransfert" method="post" class="d-inline">
                                @Html.AntiForgeryToken()<input type="hidden" name="mouvementId" value="@t.Id" />
                                <button class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-xmark"></i></button></form>
                        }
                        else { <span class="badge bg-warning text-dark">En attente</span> }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
<div class="row g-4">
@foreach (var c in Model)
{
    <div class="col-md-4">
        <div class="etam-card p-4">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h6 class="fw-bold mb-0">@c.Banque</h6><small class="text-muted">@c.Nom</small>
                    <div class="mt-1">
                        @if (c.Type == ETAM.Domain.Enums.TypeCompteBancaire.Comptes)
                        { <span class="badge bg-primary">Budget Comptes</span> }
                        else
                        { <span class="badge bg-success">Chantier : @c.Chantier?.Nom</span> }
                    </div>
                </div>
                <i class="fa-solid fa-building-columns text-primary" style="font-size:1.5rem"></i>
            </div>
            <div class="my-3"><small class="text-muted">Solde</small>
                <div class="fw-bold" style="font-size:1.4rem">@c.Solde.ToString("N0") @c.Devise</div></div>
            <small class="text-muted d-block mb-3">@c.Numero</small>
            <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-light">Mouvements</a>
            @if (User.IsInRole("Administrateur"))
            {
                <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-sm btn-light" title="Modifier"><i class="fa-solid fa-pen"></i></a>
            }
        </div>
    </div>
}
</div>
