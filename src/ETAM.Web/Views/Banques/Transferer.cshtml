@{
    ViewData["Title"] = "Fléchage vers un budget";
    var comptes = ViewBag.Chantiers as IEnumerable<ETAM.Domain.Entities.CompteBancaire> ?? Enumerable.Empty<ETAM.Domain.Entities.CompteBancaire>();
    long? preselect = ViewBag.PreselectChantierId;
}
<div class="etam-card p-4" style="max-width:640px">
<div class="alert alert-info py-2 small">
    <strong>Fléchage, pas un retrait.</strong> Vous réservez une part du solde bancaire pour un budget.
    <strong>L'argent reste en banque</strong> et le solde ne change pas : il ne diminuera qu'à l'exécution
    d'une prévision réelle, quand l'argent sort effectivement.
</div>
<form asp-action="Transferer" method="post">
    <div class="mb-3">
        <label class="form-label">Destination</label>
        <select name="cible" class="form-select" id="cible">
            <option value="Materiel" selected>Budget Matériel d'un chantier</option>
            <option value="Comptes">Budget Comptes (entreprise)</option>
        </select>
    </div>
    <div class="mb-3" id="chantierBlock">
        <label class="form-label">Chantier</label>
        <select name="chantierId" class="form-select">
            <option value="">-- choisir le chantier --</option>
            @foreach (var cpt in comptes)
            {
                var dejaFleche = (cpt.Chantier?.MaterielTransfere ?? 0m) - (cpt.Chantier?.Consommation ?? 0m);
                if (dejaFleche < 0) { dejaFleche = 0m; }
                var dispoFlechage = cpt.Solde - dejaFleche;
                if (dispoFlechage < 0) { dispoFlechage = 0m; }
                <option value="@cpt.ChantierId" selected="@(preselect == cpt.ChantierId)">
                    @cpt.Chantier?.Nom — à flécher : @dispoFlechage.ToString("N0") Ar
                    (en banque @cpt.Solde.ToString("N0") Ar, déjà réservé @dejaFleche.ToString("N0") Ar)
                </option>
            }
        </select>
        @if (!comptes.Any())
        {
            <div class="alert alert-warning small mt-2 mb-0">Aucun compte bancaire de chantier n'existe. Créez-en un depuis le menu Banques.</div>
        }
    </div>
    <div class="mb-3">
        <label class="form-label">Montant à flécher (Ar)</label>
        <input type="number" step="0.01" min="0" name="montant" class="form-control" required />
    </div>
    @if (!User.IsInRole("Administrateur"))
    {
        <div class="alert alert-info small">En tant que Responsable, votre transfert sera soumis à la validation de l'Administrateur avant d'être appliqué.</div>
    }
    <button type="submit" class="btn btn-success"><i class="fa-solid fa-arrow-right-arrow-left me-1"></i> @(User.IsInRole("Administrateur") ? "Flécher" : "Demander le fléchage")</button>
    <a asp-action="Index" class="btn btn-light">Annuler</a>
</form>
</div>
@section Scripts {
<script>
  const cible = document.getElementById('cible'), cb = document.getElementById('chantierBlock');
  function toggle(){ cb.style.display = cible.value === 'Comptes' ? 'none' : 'block'; }
  cible.addEventListener('change', toggle); toggle();
</script>
}
