@model ETAM.Domain.Entities.BudgetCompte
@{ ViewData["Title"] = "Modifier le budget"; }
<div class="etam-card p-4" style="max-width:560px">
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3"><label class="form-label">Libellé</label><input asp-for="Libelle" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Année</label><input asp-for="Annee" class="form-control" readonly /></div>
    <div class="mb-3"><label class="form-label">Montant initial (Ar)</label><input asp-for="MontantInitial" type="number" step="0.01" class="form-control" /></div>
    <div class="mb-3"><label class="form-label">Réserve (Ar)</label><input asp-for="Reserve" type="number" step="0.01" class="form-control" /></div>
    <div class="form-check mb-3"><input asp-for="EstActif" class="form-check-input" /><label asp-for="EstActif" class="form-check-label">Budget actif</label></div>
    <button type="submit" class="btn btn-primary">Enregistrer</button>
    <a asp-action="Index" class="btn btn-light">Annuler</a>
</form>
</div>
