@model List<ETAM.Domain.Entities.BudgetCompte>
@{ ViewData["Title"] = "Budget Comptes"; }
<p class="text-muted">Budget annuel unique de l'entreprise finançant toutes les dépenses générales.</p>
<div class="row g-4">
@foreach (var b in Model)
{
    <div class="col-md-6">
        <div class="etam-card p-4">
            <div class="d-flex justify-content-between">
                <h5 class="fw-bold">@b.Libelle @if (b.EstActif) { <span class="badge bg-success">Actif</span> }</h5>
                @if (User.IsInRole("Administrateur"))
                { <a asp-action="Edit" asp-route-id="@b.Id" class="btn btn-sm btn-light"><i class="fa-solid fa-pen"></i></a> }
            </div>
            <div class="row mt-3">
                <div class="col-6 mb-2"><small class="text-muted">Plafond (fixe)</small><div class="fw-bold">@b.MontantInitial.ToString("N0") Ar</div></div>
                <div class="col-6 mb-2"><small class="text-muted">Transféré depuis la banque</small><div class="fw-bold text-primary">@b.MontantTransfere.ToString("N0") Ar</div></div>
                <div class="col-6 mb-2"><small class="text-muted">Consommé</small><div class="fw-bold text-danger">@b.MontantConsomme.ToString("N0") Ar</div></div>
                <div class="col-6 mb-2"><small class="text-muted">Budget réel disponible</small><div class="fw-bold text-success">@b.DisponibleReel.ToString("N0") Ar</div></div>
                <div class="col-6 mb-2"><small class="text-muted">Réserve</small><div class="fw-bold text-warning">@b.Reserve.ToString("N0") Ar</div></div>
                <div class="col-6 mb-2"><small class="text-muted">Réserve restante</small><div class="fw-bold">@b.ReserveRestante.ToString("N0") Ar <span class="text-muted small">(utilisée : @b.ReserveUtilisee.ToString("N0"))</span></div></div>
            </div>
            <div class="etam-progress mt-2"><span style="width:@b.PourcentageConsomme%"></span></div>
            <small class="text-muted">@b.PourcentageConsomme.ToString("N1")% du plafond consommé · reste @b.MontantRestant.ToString("N0") Ar avant plafond</small>
        </div>
    </div>
}
</div>
