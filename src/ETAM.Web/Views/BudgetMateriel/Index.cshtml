@model List<ETAM.Domain.Entities.Chantier>
@{ ViewData["Title"] = "Budget Matériel"; }
@if (User.IsInRole("Administrateur") || User.IsInRole("Correspondant"))
{
    <div class="d-flex justify-content-end mb-3">
        <a asp-controller="Banques" asp-action="Transferer" class="btn btn-success"><i class="fa-solid fa-arrow-right-arrow-left me-1"></i> Transférer banque → budget</a>
    </div>
}
<div class="kpi-grid mb-4">
    <div class="kpi"><div class="kpi-icon bg-blue"><i class="fa-solid fa-boxes-stacked"></i></div>
        <div class="kpi-label">Budget Matériel global</div>
        <div class="kpi-value">@Model.Sum(c => c.BudgetMateriel).ToString("N0") Ar</div>
        <div class="kpi-sub">Somme des budgets chantiers</div></div>
    <div class="kpi"><div class="kpi-icon bg-red"><i class="fa-solid fa-fire"></i></div>
        <div class="kpi-label">Consommé</div>
        <div class="kpi-value">@Model.Sum(c => c.Consommation).ToString("N0") Ar</div></div>
    <div class="kpi"><div class="kpi-icon bg-violet"><i class="fa-solid fa-arrow-right-arrow-left"></i></div>
        <div class="kpi-label">Transféré (budget réel)</div>
        <div class="kpi-value">@Model.Sum(c => c.MaterielTransfere).ToString("N0") Ar</div></div>
    <div class="kpi"><div class="kpi-icon bg-green"><i class="fa-solid fa-piggy-bank"></i></div>
        <div class="kpi-label">Réel disponible</div>
        <div class="kpi-value">@Model.Sum(c => c.MaterielDisponible).ToString("N0") Ar</div></div>
    <div class="kpi"><div class="kpi-icon bg-amber"><i class="fa-solid fa-shield-halved"></i></div>
        <div class="kpi-label">Réserve globale</div>
        <div class="kpi-value">@Model.Sum(c => c.Reserve).ToString("N0") Ar</div>
        <div class="kpi-sub">Restante : @Model.Sum(c => c.ReserveRestante).ToString("N0") Ar</div></div>
</div>
<div class="etam-card p-3">
<table class="table table-hover align-middle datatable">
    <thead><tr><th>Chantier</th><th class="text-end">Plafond</th><th class="text-end">Transféré</th><th class="text-end">Consommé</th>
        <th class="text-end">Réel dispo.</th><th class="text-end">Avant plafond</th><th class="text-end">Réserve</th><th class="text-end">Réserve restante</th><th style="width:150px">Consommation</th></tr></thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td class="fw-semibold">@c.Nom <span class="text-muted small">(@c.Code)</span></td>
            <td class="text-end">@c.BudgetMateriel.ToString("N0")</td>
            <td class="text-end text-primary">@c.MaterielTransfere.ToString("N0")</td>
            <td class="text-end text-danger">@c.Consommation.ToString("N0")</td>
            <td class="text-end fw-semibold @(c.MaterielDisponible < 0 ? "text-danger" : "text-success")">@c.MaterielDisponible.ToString("N0")</td>
            <td class="text-end text-muted">@c.BudgetMaterielRestant.ToString("N0")</td>
            <td class="text-end">@c.Reserve.ToString("N0")</td>
            <td class="text-end fw-semibold">@c.ReserveRestante.ToString("N0")</td>
            <td><div class="etam-progress"><span style="width:@c.PourcentageConsomme%"></span></div>
                <small class="text-muted">@c.PourcentageConsomme.ToString("N1")%</small></td>
        </tr>
    }
    </tbody>
</table>
</div>
