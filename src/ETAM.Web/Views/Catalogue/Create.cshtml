@model ETAM.Domain.Entities.ArticleCatalogue
@{ ViewData["Title"] = "Nouvelle désignation"; }
<div class="etam-card p-4" style="max-width:560px">
<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>
    <div class="mb-3"><label class="form-label">Désignation</label>
        <input asp-for="Designation" class="form-control" required /><span asp-validation-for="Designation" class="text-danger small"></span></div>
    <div class="mb-3"><label class="form-label">Catégorie</label>
        <input asp-for="Categorie" class="form-control" list="cats" />
        <datalist id="cats"><option value="Nourriture"></option><option value="Carburant"></option><option value="Eau"></option><option value="Transport"></option><option value="Gros œuvre"></option><option value="Ferraillage"></option><option value="Forage"></option><option value="Bois"></option><option value="Consommable"></option></datalist>
    </div>
    <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Unité</label>
            <input asp-for="Unite" class="form-control" placeholder="sac, ml, m3, litre..." /></div>
        <div class="col-6 mb-3"><label class="form-label">Prix unitaire (Ar)</label>
            <input asp-for="PrixUnitaire" type="number" step="0.01" class="form-control" /></div>
    </div>
    <button type="submit" class="btn btn-primary">Enregistrer</button>
    <a asp-action="Index" class="btn btn-light">Annuler</a>
</form>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
