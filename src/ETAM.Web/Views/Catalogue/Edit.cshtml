@model ETAM.Domain.Entities.ArticleCatalogue
@{ ViewData["Title"] = "Modifier la désignation"; }
<div class="etam-card p-4" style="max-width:560px">
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3"><label class="form-label">Désignation</label><input asp-for="Designation" class="form-control" required /></div>
    <div class="mb-3"><label class="form-label">Catégorie</label><input asp-for="Categorie" class="form-control" /></div>
    <div class="row">
        <div class="col-6 mb-3"><label class="form-label">Unité</label><input asp-for="Unite" class="form-control" /></div>
        <div class="col-6 mb-3"><label class="form-label">Prix unitaire (Ar)</label><input asp-for="PrixUnitaire" type="number" step="0.01" class="form-control" /></div>
    </div>
    <button type="submit" class="btn btn-primary">Enregistrer</button>
    <a asp-action="Index" class="btn btn-light">Annuler</a>
</form>
</div>
