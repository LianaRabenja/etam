@model List<ETAM.Domain.Entities.ArticleCatalogue>
@{ ViewData["Title"] = "Catalogue des désignations"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">@Model.Count désignation(s) enregistrée(s). Elles alimentent l'autocomplétion des approvisionnements.</p>
    <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i> Nouvelle désignation</a>
</div>
<div class="etam-card p-3">
<table class="table table-hover align-middle datatable">
    <thead><tr><th>Désignation</th><th>Catégorie</th><th>Unité</th><th class="text-end">Prix unitaire</th><th></th></tr></thead>
    <tbody>
    @foreach (var a in Model)
    {
        <tr>
            <td class="fw-semibold">@a.Designation</td>
            <td class="small text-muted">@a.Categorie</td>
            <td class="small">@a.Unite</td>
            <td class="text-end">@a.PrixUnitaire.ToString("N0") Ar</td>
            <td class="text-end text-nowrap">
                <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-light"><i class="fa-solid fa-pen"></i></a>
                <form asp-action="Delete" asp-route-id="@a.Id" method="post" class="d-inline" onsubmit="return confirm('Retirer cette désignation ?');">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-sm btn-light text-danger"><i class="fa-solid fa-trash"></i></button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
