@model ETAM.Application.DTOs.ChantierCreateDto
@{
    ViewData["Title"] = "Nouveau chantier";
    var banques = ViewBag.Banques as List<ETAM.Domain.Entities.Banque> ?? new();
}
<div class="etam-card p-4" style="max-width:720px">
<form asp-action="Create" method="post">
    @* « All » et pas « ModelOnly » : sinon une erreur sur un montant ou une date
       n'avait aucun endroit où s'afficher, la page se rechargeait à l'identique,
       et on croyait l'application cassée. *@
    <div asp-validation-summary="All" class="text-danger small mb-2"></div>
    <div class="row g-3">
        <div class="col-md-8"><label class="form-label">Nom</label>
            <input asp-for="Nom" class="form-control" /><span asp-validation-for="Nom" class="text-danger small"></span></div>
        <div class="col-md-4"><label class="form-label">Code</label>
            <input asp-for="Code" class="form-control" /><span asp-validation-for="Code" class="text-danger small"></span></div>
        <div class="col-md-6"><label class="form-label">Localisation</label>
            <input asp-for="Localisation" class="form-control" />
            <span asp-validation-for="Localisation" class="text-danger small"></span></div>
        <div class="col-md-6"><label class="form-label">Responsable</label>
            <input asp-for="Responsable" class="form-control" />
            <span asp-validation-for="Responsable" class="text-danger small"></span></div>
        <div class="col-md-4"><label class="form-label">Date début</label>
            <input asp-for="DateDebut" type="date" class="form-control" />
            <span asp-validation-for="DateDebut" class="text-danger small"></span></div>
        <div class="col-md-4"><label class="form-label">Date fin</label>
            <input asp-for="DateFin" type="date" class="form-control" />
            <span asp-validation-for="DateFin" class="text-danger small"></span></div>
        <div class="col-md-4"><label class="form-label">Statut</label>
            <select asp-for="Statut" asp-items="Html.GetEnumSelectList<StatutChantier>()" class="form-select"></select></div>
        <div class="col-12"><hr class="my-1" /><h6 class="fw-bold mb-0">Marché</h6>
            <small class="text-muted">Saisissez le marché et ce que le chantier a le droit de dépenser. Le bénéfice s'en déduit.</small></div>
        <div class="col-md-4"><label class="form-label">Montant du marché (Ar)</label>
            <input asp-for="MontantMarche" id="inMarche" type="number" step="0.01" class="form-control" />
            <span asp-validation-for="MontantMarche" class="text-danger small"></span></div>
        <div class="col-md-4"><label class="form-label">Bénéfice (calculé)</label>
            <input id="inBenefice" class="form-control bg-light" readonly value="0" />
            <small class="text-muted">Marché − budget du projet.</small></div>
        <div class="col-md-4"><label class="form-label">Budget du projet (Ar)</label>
            <input asp-for="BudgetProjet" id="inBudgetProjet" type="number" step="0.01" class="form-control" />
            <small class="text-muted">Ce que couvrira la prévision globale.</small>
            <span asp-validation-for="BudgetProjet" class="text-danger small"></span></div>

        <div class="col-12"><hr class="my-1" /><h6 class="fw-bold mb-0">Compte bancaire du chantier</h6>
            <small class="text-muted">Ce compte est créé automatiquement avec le chantier. La somme indiquée y entre à l'ouverture.</small></div>
        <div class="col-md-4"><label class="form-label">Banque</label>
            @if (banques.Any())
            {
                <select asp-for="NomBanque" class="form-select">
                    @foreach (var b in banques)
                    {
                        <option value="@b.Sigle">@b.Libelle</option>
                    }
                </select>
            }
            else
            {
                <input asp-for="NomBanque" class="form-control" placeholder="BNI, BOA, BFV..." />
                <small class="text-warning">Aucune banque enregistrée — ajoutez-en dans Banques → Les banques.</small>
            }
            <span asp-validation-for="NomBanque" class="text-danger small"></span></div>
        <div class="col-md-4"><label class="form-label">Numéro de compte</label>
            <input asp-for="NumeroCompte" id="inNumero" class="form-control" placeholder="ex : 00012 345678 90" />
            <span asp-validation-for="NumeroCompte" class="text-danger small"></span></div>
        <div class="col-md-4"><label class="form-label">Somme perçue (Ar)</label>
            <input asp-for="MontantEnBanque" id="inEnBanque" type="number" step="0.01" class="form-control" />
            <small class="text-muted">Par défaut le montant du marché — corrigez si le versement est différent.</small>
            <span asp-validation-for="MontantEnBanque" class="text-danger small"></span></div>
        <div class="col-12"><label class="form-label">Observation</label>
            <textarea asp-for="Observation" class="form-control" rows="2"></textarea></div>
    </div>
    <div class="mt-4">
        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check me-1"></i> Enregistrer</button>
        <a asp-action="Index" class="btn btn-light">Annuler</a>
    </div>
</form>
</div>
@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
  (function(){
    var m = document.getElementById('inMarche'),
        bp = document.getElementById('inBudgetProjet'),
        r = document.getElementById('inBenefice');
    var banque = document.getElementById('inEnBanque'),
        numero = document.getElementById('inNumero'),
        code   = document.getElementById('Code'),
        banqueTouchee = false;
    if (banque) banque.addEventListener('input', function(){ banqueTouchee = true; });
    function maj(){
      // Bénéfice = marché − budget du projet. C'est le budget qu'on saisit.
      var v = (parseFloat(m.value)||0) - (parseFloat(bp.value)||0);
      r.value = new Intl.NumberFormat('fr-FR').format(Math.round(v));
      r.classList.toggle('text-danger', v < 0);
      // Tant que l'utilisateur n'a pas saisi de montant bancaire, on recopie le marche.
      if (banque && !banqueTouchee) banque.value = m.value;
    }
    m.addEventListener('input', maj); bp.addEventListener('input', maj); maj();
    // Numero de compte propose a partir du code chantier, modifiable.
    if (code && numero) {
      code.addEventListener('input', function(){
        if (!numero.dataset.touche) numero.value = code.value ? 'CH-' + code.value : '';
      });
      numero.addEventListener('input', function(){ numero.dataset.touche = '1'; });
    }
  })();
</script>
}
