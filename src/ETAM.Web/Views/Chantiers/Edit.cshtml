@model ETAM.Domain.Entities.Chantier
@{ ViewData["Title"] = $"Modifier {Model.Nom}"; }
<div class="etam-card p-4" style="max-width:760px">
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="row g-3">
        <div class="col-md-8"><label class="form-label">Nom</label><input asp-for="Nom" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">Code</label><input asp-for="Code" class="form-control" /></div>
        <div class="col-md-6"><label class="form-label">Localisation</label><input asp-for="Localisation" class="form-control" /></div>
        <div class="col-md-6"><label class="form-label">Responsable</label><input asp-for="Responsable" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">Date début</label><input asp-for="DateDebut" type="date" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">Date fin</label><input asp-for="DateFin" type="date" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">Statut</label>
            <select asp-for="Statut" asp-items="Html.GetEnumSelectList<ETAM.Domain.Enums.StatutChantier>()" class="form-select"></select></div>
        <div class="col-md-4"><label class="form-label">Budget projet / Budget Matériel (Ar)</label>
            <input class="form-control bg-light" readonly value="@Model.BudgetProjet.ToString("N0")" />
            <small class="text-muted">Calculé : marché − bénéfice.</small></div>
        <div class="col-md-4"><label class="form-label">Réserve (Ar)</label><input asp-for="Reserve" type="number" step="0.01" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">Avancement (%)</label><input asp-for="PourcentageAvancement" type="number" step="1" min="0" max="100" class="form-control" /></div>
        <div class="col-12"><label class="form-label">Observation</label><textarea asp-for="Observation" class="form-control" rows="2"></textarea></div>
    </div>
    <div class="mt-4">
        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check me-1"></i> Enregistrer</button>
        <a asp-action="Index" class="btn btn-light">Annuler</a>
    </div>
</form>
</div>
