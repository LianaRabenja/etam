@model List<ETAM.Web.Controllers.LigneSortie>
@using ETAM.Domain.Enums
@{
    ViewData["Title"] = "Sorties d'argent";
    // L'argent sort de la banque à l'exécution d'une prévision ET il est dépensé
    // dans le même geste. Ce total EST la dépense — ce n'est pas une avance dont
    // il resterait quelque chose.
    var totalDepense = (decimal)(ViewBag.TotalRemis ?? 0m);
    // Les paiements ne sortent aucun argent : ils disent à qui la dépense a servi
    // et font descendre le stock. Ce qui n'est pas détaillé n'est pas « à utiliser »,
    // c'est seulement une dépense dont on ne connaît pas encore le bénéficiaire.
    var totalDetaille = (decimal)(ViewBag.TotalDistribue ?? 0m);
    var aDetailler = totalDepense - totalDetaille;
}
<partial name="_FiltreChantier" />

@functions {
    string LibelleMode(ModePaiement? m) => m switch
    {
        ModePaiement.Especes => "Espèces",
        ModePaiement.Cheque => "Chèque",
        ModePaiement.Virement => "Virement",
        ModePaiement.MobileMoney => "Mobile Money",
        _ => ""
    };
}

<div class="mb-3">
    <h5 class="mb-0">Sorties d'argent</h5>
</div>

<div class="etam-card p-3 mb-3 text-center">
    <div class="text-muted small">Dépensé sur les chantiers</div>
    <div class="fw-bold" style="font-size:1.8rem;color:#b91c1c">
        @totalDepense.ToString("N0") Ar
    </div>
    <small class="text-muted">
        sorti de la banque à l'exécution des prévisions réelles
    </small>
    <div class="mt-2 small">
        <span class="text-success">@totalDetaille.ToString("N0") Ar détaillés par bénéficiaire</span>
        @if (aDetailler > 0)
        {
            <span class="text-muted"> · </span>
            <span class="text-warning">@aDetailler.ToString("N0") Ar pas encore détaillés</span>
        }
    </div>
    <div class="text-muted small mt-1">
        Le détail ne sort aucun argent : il dit à qui la dépense a servi et fait descendre le stock.
    </div>
</div>

<div class="etam-card p-3">
@if (!Model.Any())
{
    <p class="text-muted mb-0">
        Aucune sortie d'argent. Dès qu'une prévision journalière est exécutée,
        sa remise d'enveloppe apparaît ici automatiquement.
    </p>
}
else
{
    <table class="table table-hover align-middle datatable">
        <thead><tr>
            <th>Date</th><th>Nature</th><th>Chantier</th>
            <th>Bénéficiaire</th><th>Motif</th><th>Mode</th>
            <th class="text-end">Montant</th><th></th>
        </tr></thead>
        <tbody>
        @foreach (var l in Model)
        {
            <tr class="@(l.EstRemise ? "table-light" : "")">
                <td>@l.Date.ToString("dd/MM/yyyy")</td>
                <td>
                    @if (l.EstRemise)
                    {
                        <span class="badge bg-danger">dépense</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">détail</span>
                    }
                </td>
                <td class="small">@l.Chantier</td>
                <td class="fw-semibold">@l.Beneficiaire</td>
                <td class="small">
                    @l.Motif
                    @if (l.EstRemise && !string.IsNullOrEmpty(l.Signataire))
                    {
                        <span class="text-success small">— reçu signé par @l.Signataire</span>
                    }
                    else if (l.EstRemise)
                    {
                        <span class="text-warning small">— reçu pas encore signé</span>
                    }
                </td>
                <td class="small text-muted">@LibelleMode(l.Mode)</td>
                <td class="text-end fw-semibold">@l.Montant.ToString("N0") Ar</td>
                <td class="text-end">
                    <a asp-controller="Prevision" asp-action="Details" asp-route-id="@l.PrevisionId"
                       class="btn btn-sm btn-outline-primary">Voir</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
</div>
