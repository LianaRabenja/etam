@model ETAM.Domain.Entities.Depense
@{ ViewData["Title"] = "Nouvelle dépense"; var chantiers = ViewBag.Chantiers as IEnumerable<ETAM.Domain.Entities.Chantier>; }
<div class="etam-card p-4" style="max-width:760px">
<form asp-action="Create" method="post">
    <div class="row g-3">
        <div class="col-md-4"><label class="form-label">Date</label>
            <input asp-for="Date" type="date" class="form-control" /></div>
        <div class="col-md-8"><label class="form-label">Chantier</label>
            <select asp-for="ChantierId" class="form-select" required>
                <option value="">-- choisir --</option>
                @foreach (var c in chantiers ?? Enumerable.Empty<ETAM.Domain.Entities.Chantier>())
                { <option value="@c.Id">@c.Nom (@c.Code)</option> }
            </select></div>
        <div class="col-md-8"><label class="form-label">Désignation</label>
            <input asp-for="Designation" class="form-control" required /></div>
        <div class="col-md-4"><label class="form-label">Catégorie</label>
            <input asp-for="Categorie" class="form-control" required /></div>
        <div class="col-md-4"><label class="form-label">Budget concerné</label>
            <select asp-for="BudgetConcerne" asp-items="Html.GetEnumSelectList<ETAM.Domain.Enums.TypeBudget>()" class="form-select"></select></div>
        <div class="col-md-4"><label class="form-label">Quantité</label>
            <input asp-for="Quantite" type="number" step="0.001" class="form-control" value="1" /></div>
        <div class="col-md-4"><label class="form-label">Prix unitaire (Ar)</label>
            <input asp-for="PrixUnitaire" type="number" step="0.01" class="form-control" /></div>
        <div class="col-md-8"><label class="form-label">Justificatif</label>
            <input asp-for="Justificatif" class="form-control" placeholder="N° facture, référence..." /></div>
        <div class="col-12"><label class="form-label">Observation</label>
            <textarea asp-for="Observation" class="form-control" rows="2"></textarea></div>
    </div>
    <div class="mt-4">
        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check me-1"></i> Enregistrer</button>
        <a asp-action="Index" class="btn btn-light">Annuler</a>
    </div>
</form>
</div>
