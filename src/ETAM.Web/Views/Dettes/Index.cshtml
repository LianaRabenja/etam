@model List<ETAM.Domain.Entities.DetteFournisseur>
@{ ViewData["Title"] = "Dettes fournisseurs";
   var totalDu = Model.Where(d => d.Statut != ETAM.Domain.Enums.StatutDette.Soldee).Sum(d => d.SoldeRestant); }
<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">Total restant dû : <strong class="text-danger">@totalDu.ToString("N0") Ar</strong></p>
    <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i> Nouvelle dette</a>
</div>
<div class="etam-card p-3">
<table class="table table-hover align-middle datatable">
    <thead><tr><th>Fournisseur</th><th>Libellé</th><th>Chantier</th><th class="text-end">Montant</th>
        <th class="text-end">Payé</th><th class="text-end">Restant</th><th>Échéance</th><th>Statut</th><th></th></tr></thead>
    <tbody>
    @foreach (var d in Model)
    {
        var badge = d.Statut switch {
            ETAM.Domain.Enums.StatutDette.Soldee => "bg-success",
            ETAM.Domain.Enums.StatutDette.PartiellementPayee => "bg-warning text-dark",
            _ => "bg-danger" };
        <tr>
            <td class="fw-semibold">@d.Fournisseur?.Nom</td>
            <td class="small">@d.Libelle</td>
            <td class="small text-muted">@d.Chantier?.Nom</td>
            <td class="text-end">@d.MontantInitial.ToString("N0")</td>
            <td class="text-end text-success">@d.MontantPaye.ToString("N0")</td>
            <td class="text-end fw-semibold text-danger">@d.SoldeRestant.ToString("N0")</td>
            <td class="small">@(d.DateEcheance?.ToLocalTime().ToString("dd/MM/yyyy") ?? "—")</td>
            <td><span class="badge @badge">@d.Statut</span></td>
            <td class="text-end">
                @if (d.Statut != ETAM.Domain.Enums.StatutDette.Soldee)
                {
                    <a asp-action="Payer" asp-route-id="@d.Id" class="btn btn-sm btn-primary"><i class="fa-solid fa-money-bill-transfer me-1"></i> Payer</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
