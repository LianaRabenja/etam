@model List<ETAM.Domain.Entities.Fournisseur>
@{ ViewData["Title"] = "Fournisseurs"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">@Model.Count fournisseur(s)</p>
    <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i> Nouveau fournisseur</a>
</div>
<div class="etam-card p-3">
<table class="table table-hover align-middle datatable">
    <thead><tr><th>Nom</th><th>Contact</th><th>Téléphone</th><th>Adresse</th><th>NIF</th></tr></thead>
    <tbody>
    @foreach (var f in Model)
    {
        <tr><td class="fw-semibold">@f.Nom</td><td class="small">@f.Contact</td>
            <td class="small">@f.Telephone</td><td class="small text-muted">@f.Adresse</td><td class="small">@f.Nif</td></tr>
    }
    </tbody>
</table>
</div>
