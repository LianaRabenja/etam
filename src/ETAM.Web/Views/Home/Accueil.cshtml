@{
    ViewData["Title"] = "Accueil";
    var isChef = User.IsInRole("Chef de chantier");
    var isMagasinier = User.IsInRole("Magasinier");
    var userName = User.Identity?.Name ?? "";
}
<div class="mb-4">
    <h4 class="fw-bold mb-1">Bienvenue@(string.IsNullOrEmpty(userName) ? "" : ", " + userName)</h4>
    <p class="text-muted mb-0">Voici vos accès rapides.</p>
</div>

<div class="row g-3">
    @if (isChef)
    {
        <div class="col-md-4">
            <a href="/Approvisionnement/Index" class="text-decoration-none">
                <div class="etam-card p-4 h-100">
                    <i class="fa-solid fa-cart-flatbed fa-2x text-primary mb-2"></i>
                    <h6 class="fw-bold mb-1">Approvisionnements</h6>
                    <p class="text-muted small mb-0">Suivre les approvisionnements de mon chantier.</p>
                </div>
            </a>
        </div>
    }
    @if (isChef || isMagasinier)
    {
        <div class="col-md-4">
            <a href="/Materiaux/Index" class="text-decoration-none">
                <div class="etam-card p-4 h-100">
                    <i class="fa-solid fa-trowel-bricks fa-2x text-warning mb-2"></i>
                    <h6 class="fw-bold mb-1">Stock (Matériaux)</h6>
                    <p class="text-muted small mb-0">Consulter l'état du stock de matériaux.</p>
                </div>
            </a>
        </div>
    }
    @if (isChef)
    {
        <div class="col-md-4">
            <a href="/RapportsTravail/Index" class="text-decoration-none">
                <div class="etam-card p-4 h-100">
                    <i class="fa-solid fa-file-signature fa-2x text-success mb-2"></i>
                    <h6 class="fw-bold mb-1">Rapport de travail</h6>
                    <p class="text-muted small mb-0">Consulter les rapports hebdomadaires d'avancement.</p>
                </div>
            </a>
        </div>
    }
    <div class="col-md-4">
        <a href="/Alertes/Index" class="text-decoration-none">
            <div class="etam-card p-4 h-100">
                <i class="fa-solid fa-bell fa-2x text-danger mb-2"></i>
                <h6 class="fw-bold mb-1">Alertes</h6>
                <p class="text-muted small mb-0">Voir mes notifications.</p>
            </div>
        </a>
    </div>
</div>

@if (!isChef && !isMagasinier)
{
    <div class="alert alert-light border mt-4">
        Aucun accès rapide n'est configuré pour votre rôle pour le moment. Contactez l'administrateur si vous pensez que c'est une erreur.
    </div>
}
