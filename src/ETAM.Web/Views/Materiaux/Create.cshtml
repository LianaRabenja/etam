@model ETAM.Domain.Entities.Materiau
@{ ViewData["Title"] = "Nouveau matériau"; var chantiers = ViewBag.Chantiers as IEnumerable<ETAM.Domain.Entities.Chantier>; }
<div class="etam-card p-4" style="max-width:760px">
<form asp-action="Create" method="post">
    <div class="row g-3">
        <div class="col-md-6"><label class="form-label">Chantier</label>
            <select asp-for="ChantierId" class="form-select" required>
                <option value="">-- choisir --</option>
                @foreach (var c in chantiers ?? Enumerable.Empty<ETAM.Domain.Entities.Chantier>())
                { <option value="@c.Id">@c.Nom (@c.Code)</option> }
            </select></div>
        <div class="col-md-6"><label class="form-label">Catégorie</label>
            <input asp-for="Categorie" class="form-control" required /></div>
        <div class="col-md-8"><label class="form-label">Désignation</label>
            <input asp-for="Designation" class="form-control" required /></div>
        <div class="col-md-4"><label class="form-label">Unité</label>
            <input asp-for="Unite" class="form-control" placeholder="sac, ml, m3..." required /></div>
        <div class="col-md-6"><label class="form-label">Localité</label>
            <input asp-for="Localite" class="form-control" placeholder="Centre, Église..." /></div>
        <div class="col-md-6"><label class="form-label">Besoin ou objectif (total)</label>
            <input asp-for="Besoin" type="number" step="0.001" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">Quantité commandée</label>
            <input asp-for="QuantiteCommandee" type="number" step="0.001" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">Quantité reçue</label>
            <input asp-for="QuantiteRecue" type="number" step="0.001" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">Seuil minimal</label>
            <input asp-for="SeuilMinimal" type="number" step="0.001" class="form-control" /></div>
        <div class="col-md-6"><label class="form-label">Prix unitaire (Ar)</label>
            <input asp-for="PrixUnitaire" type="number" step="0.01" class="form-control" /></div>
    </div>
    <div class="mt-4">
        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check me-1"></i> Enregistrer</button>
        <a asp-action="Index" class="btn btn-light">Annuler</a>
    </div>
</form>
</div>
