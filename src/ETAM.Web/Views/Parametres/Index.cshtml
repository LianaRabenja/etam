@model List<ETAM.Domain.Entities.Parametre>
@{ ViewData["Title"] = "Paramètres"; }
<p class="text-muted">Configuration générale de l'application.</p>
<div class="etam-card p-3">
<table class="table align-middle">
    <thead><tr><th>Groupe</th><th>Clé</th><th>Valeur</th><th></th></tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td class="small text-muted">@p.Groupe</td>
            <td class="fw-semibold">@p.Cle<br/><small class="text-muted">@p.Description</small></td>
            <td>
                <form asp-action="Enregistrer" method="post" class="d-flex gap-2">
                    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id" />
                    <input name="valeur" value="@p.Valeur" class="form-control form-control-sm" style="max-width:280px" />
                    <button class="btn btn-sm btn-primary">OK</button>
                </form>
            </td>
            <td></td>
        </tr>
    }
    </tbody>
</table>
</div>
