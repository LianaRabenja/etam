@model ETAM.Domain.Entities.PrevisionJournaliere
@using ETAM.Domain.Enums
@{
    ViewData["Title"] = $"Prévision {Model.Reference}";
    var totalCompte = Model.Lignes.Where(l => l.TypeBudget == TypeBudget.Compte).Sum(l => l.Total);
    var totalMateriel = Model.Lignes.Where(l => l.TypeBudget == TypeBudget.Materiel).Sum(l => l.Total);
    decimal bcRestant = ViewBag.BudgetCompteRestant ?? 0m;
    decimal bmRestant = ViewBag.BudgetMaterielRestant ?? 0m;
    var depasseCompte = totalCompte > bcRestant;
    var depasseMateriel = totalMateriel > bmRestant;
    var resteApres = ViewBag.ResteApres as Dictionary<long, decimal> ?? new Dictionary<long, decimal>();
    // Tant que la prévision n'est pas validée par l'Administrateur, le reste affiché
    // est une projection : ces montants ne sont pas encore engagés.
    var estProjection = Model.Statut != StatutPrevision.ValideeAdministrateur
                     && Model.Statut != StatutPrevision.Executee
                     && Model.Statut != StatutPrevision.RapportSoumis
                     && Model.Statut != StatutPrevision.Cloturee;

    // Libellés lisibles : sans cela l'écran affiche le nom brut de l'énumération.
    string LibelleStatut(StatutPrevision s) => s switch
    {
        StatutPrevision.Brouillon => "Brouillon",
        StatutPrevision.Soumise => "Soumise",
        StatutPrevision.ValideeResponsableFinancier => "Validée Correspondant",
        StatutPrevision.ValideeAdministrateur => "Validée Administrateur",
        StatutPrevision.Executee => "Exécutée",
        StatutPrevision.Refusee => "Refusée",
        StatutPrevision.RapportSoumis => "Compte rendu à réceptionner",
        StatutPrevision.Cloturee => "Clôturée",
        _ => s.ToString()
    };
}
<div class="row g-4">
    <div class="col-lg-8">
        <div class="etam-card p-4">
            <div class="d-flex justify-content-between">
                <h5 class="fw-bold">@Model.Reference</h5>
                <div>
                    @if (Model.EstModifiable && (User.IsInRole("Administrateur") || User.IsInRole("Correspondant")))
                    {
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-sm btn-light"><i class="fa-solid fa-pen me-1"></i> Modifier</a>
                    }
                    <partial name="_BoutonsExport" model='new ETAM.Web.Models.ExportLiens("Prevision", "ExportDetail", Model.Id)' />
                    <span class="badge bg-secondary align-self-start">@LibelleStatut(Model.Statut)</span>
                </div>
            </div>
            <p class="text-muted mb-3">Chantier : <strong>@Model.Chantier?.Nom</strong> · @Model.DatePrevision.ToString("dd/MM/yyyy")</p>
            <table class="table table-sm align-middle">
                <thead><tr><th>Désignation</th><th>Poste prévu</th><th>Type</th><th class="text-end">Qté</th><th class="text-end">P.U.</th><th class="text-end">Total</th><th class="text-end">Reste sur l'enveloppe</th></tr></thead>
                <tbody>
                @foreach (var l in Model.Lignes)
                {
                    <tr>
                        <td>@l.Designation<div class="small text-muted">@l.Categorie</div></td>
                        <td class="small">
                            @if (l.PrevisionGlobaleLigne is not null)
                            {
                                var env = l.PrevisionGlobaleLigne.Quantite * l.PrevisionGlobaleLigne.PrixUnitaire;
                                <span class="fw-semibold">@l.PrevisionGlobaleLigne.Rubrique</span>
                                <div class="text-muted" title="Enveloppe : @env.ToString("N0") Ar">
                                    @l.PrevisionGlobaleLigne.Designation
                                </div>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Non rattaché</span>
                            }
                        </td>
                        <td><span class="badge @(l.TypeBudget == TypeBudget.Compte ? "bg-primary" : "bg-success")">@l.TypeBudget</span></td>
                        <td class="text-end">@l.Quantite.ToString("N2")</td>
                        <td class="text-end">@l.PrixUnitaireEstime.ToString("N0")</td>
                        <td class="text-end fw-semibold">@l.Total.ToString("N0")</td>
                        <td class="text-end">
                            @if (l.PrevisionGlobaleLigne is null)
                            {
                                <span class="text-muted">—</span>
                            }
                            else if (resteApres.TryGetValue(l.Id, out var reste))
                            {
                                var env = l.PrevisionGlobaleLigne.Quantite * l.PrevisionGlobaleLigne.PrixUnitaire;
                                var pct = env <= 0 ? 0 : (double)((env - reste) / env) * 100d;
                                <span class="fw-semibold @(reste < 0 ? "text-danger" : pct >= 50 ? "text-warning" : "text-success")">
                                    @reste.ToString("N0")
                                </span>
                                <div class="small text-muted">@pct.ToString("N0") % consommé</div>
                                @if (reste < 0)
                                {
                                    <div class="small text-danger">enveloppe dépassée</div>
                                }
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
                <tfoot><tr><th colspan="5" class="text-end">Total</th><th class="text-end">@Model.Total.ToString("N0") Ar</th><th></th></tr></tfoot>
            </table>
            @if (resteApres.Any() && estProjection)
            {
                <p class="small text-warning mb-1">
                    <i class="fa-solid fa-circle-info me-1"></i>
                    Reste indicatif : cette prévision n'est pas encore validée.
                </p>
            }
            @if (!string.IsNullOrEmpty(Model.Observation)) { <p class="small text-muted mb-0">@Model.Observation</p> }
            @if (!string.IsNullOrEmpty(Model.MotifRefus)) { <p class="small text-danger mb-0">Motif de refus : @Model.MotifRefus</p> }
        </div>
    </div>

    <div class="col-lg-4">
        <!-- Impact budgétaire : aide à la décision avant validation -->
        <div class="etam-card p-4 mb-4">
            <h6 class="fw-bold mb-3">Impact budgétaire</h6>
            <div class="d-flex justify-content-between mb-1"><span class="small text-muted">Budget Comptes</span>
                <span class="fw-semibold">@totalCompte.ToString("N0") Ar</span></div>
            <div class="small mb-2 @(depasseCompte ? "text-danger" : "text-success")">
                <i class="fa-solid @(depasseCompte ? "fa-triangle-exclamation" : "fa-check")"></i>
                Restant après : @((bcRestant - totalCompte).ToString("N0")) Ar
            </div>
            <div class="d-flex justify-content-between mb-1"><span class="small text-muted">Budget Matériel (@Model.Chantier?.Nom)</span>
                <span class="fw-semibold">@totalMateriel.ToString("N0") Ar</span></div>
            <div class="small @(depasseMateriel ? "text-danger" : "text-success")">
                <i class="fa-solid @(depasseMateriel ? "fa-triangle-exclamation" : "fa-check")"></i>
                Restant après : @((bmRestant - totalMateriel).ToString("N0")) Ar
            </div>
            @if (depasseCompte || depasseMateriel)
            {
                <div class="alert alert-warning small mt-3 mb-0">Cette prévision dépasse un budget : l'exécution nécessitera la réserve (validation Administrateur).</div>
            }
        </div>

        <!-- Actions du workflow, selon statut et rôle -->
        <div class="etam-card p-4">
            <h6 class="fw-bold mb-3">Workflow</h6>

            @if (Model.Statut == StatutPrevision.Brouillon)
            {
                <form asp-action="Soumettre" method="post" class="mb-2">
                    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                    <button class="btn btn-info w-100"><i class="fa-solid fa-paper-plane me-1"></i> Soumettre</button>
                </form>
            }
            @if (Model.Statut == StatutPrevision.Soumise && (User.IsInRole("Administrateur") || User.IsInRole("Correspondant")))
            {
                <form asp-action="ValiderRf" method="post" class="mb-2">
                    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                    <button class="btn btn-primary w-100"><i class="fa-solid fa-check me-1"></i> Valider (Responsable Financier)</button>
                </form>
            }
            @if (Model.Statut == StatutPrevision.ValideeResponsableFinancier && User.IsInRole("Administrateur"))
            {
                <form asp-action="ValiderAdmin" method="post" class="mb-2">
                    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                    <button class="btn btn-warning w-100"><i class="fa-solid fa-check-double me-1"></i> Valider (Administrateur)</button>
                </form>
            }
            @if (Model.Statut == StatutPrevision.ValideeAdministrateur && User.IsInRole("Administrateur"))
            {
                <form asp-action="Executer" method="post" class="mb-2">
                    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                    <input type="hidden" name="utiliserReserve" value="@((depasseCompte || depasseMateriel).ToString().ToLower())" />
                    <button class="btn btn-success w-100"><i class="fa-solid fa-gears me-1"></i> Exécuter</button>
                </form>
            }
            @if (Model.Statut != StatutPrevision.Executee && Model.Statut != StatutPrevision.Refusee
                 && (User.IsInRole("Administrateur") || User.IsInRole("Correspondant")))
            {
                <button class="btn btn-outline-danger w-100" data-bs-toggle="modal" data-bs-target="#modalRefus">
                    <i class="fa-solid fa-xmark me-1"></i> Refuser
                </button>
            }
            @if (Model.Statut == StatutPrevision.Executee)
            {
                <div class="alert alert-success small mb-2"><i class="fa-solid fa-circle-check me-1"></i> Prévision exécutée le @Model.DateExecution?.ToLocalTime().ToString("dd/MM/yyyy")</div>
                <div class="alert alert-warning small mb-0">
                    <i class="fa-solid fa-triangle-exclamation me-1"></i>
                    Travaux à justifier : tant que l'Administrateur n'a pas réceptionné les travaux,
                    aucune nouvelle prévision ne peut être demandée pour ce chantier.
                </div>
            }
            @if (Model.Statut == StatutPrevision.RapportSoumis)
            {
                <div class="alert alert-info small mb-0"><i class="fa-solid fa-hourglass-half me-1"></i> Compte rendu envoyé — en attente de réception par l'Administrateur.</div>
            }
            @if (Model.Statut == StatutPrevision.Cloturee)
            {
                <div class="alert alert-success small mb-0"><i class="fa-solid fa-flag-checkered me-1"></i> Travaux réceptionnés le @Model.DateValidationRapport?.ToLocalTime().ToString("dd/MM/yyyy") — cycle clos.</div>
            }
            @if (Model.Statut == StatutPrevision.Refusee)
            {
                <div class="alert alert-danger small mb-0"><i class="fa-solid fa-ban me-1"></i> Prévision refusée</div>
            }
        </div>
    </div>
</div>

<!-- ============ Argent de la journée, décaissements et justificatifs ============ -->
@await Html.PartialAsync("_EnveloppeDuJour", Model)

<!-- ============ Compte rendu des travaux réalisés ============ -->
@if (Model.Statut == StatutPrevision.Executee || Model.Statut == StatutPrevision.RapportSoumis
     || Model.Statut == StatutPrevision.Cloturee)
{
    <div class="etam-card p-4 mb-3">
        <h6 class="fw-bold mb-3"><i class="fa-solid fa-clipboard-check me-1 text-primary"></i> Travaux réalisés avec cette prévision</h6>

        @if (!string.IsNullOrWhiteSpace(Model.MotifRefusRapport))
        {
            <div class="alert alert-danger small"><strong>Compte rendu renvoyé :</strong> @Model.MotifRefusRapport</div>
        }

        @if (Model.Statut == StatutPrevision.Executee)
        {
            @if (User.IsInRole("Chef de chantier") || User.IsInRole("Administrateur") || User.IsInRole("Correspondant"))
            {
                @* Un seul formulaire : le texte du compte rendu et ses factures partent ensemble. *@
                <form asp-action="SoumettreRapport" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />

                    <label class="form-label">Décrivez ce qui a été fait avec cet argent</label>
                    <textarea name="rapport" class="form-control mb-3" rows="4" required
                              placeholder="Ex : coulage de la dalle du 1er étage, 3 t de ciment utilisées, acompte versé aux maçons...">@Model.RapportRealisation</textarea>

                    <label class="form-label">
                        Factures et justificatifs
                        <span class="text-muted fw-normal">— photos ou PDF, 5 Mo maximum par fichier</span>
                    </label>
                    <input type="file" name="factures" class="form-control mb-2" multiple
                           accept="image/*,application/pdf" />

                    <div class="row g-2 mb-3">
                        <div class="col-md-4">
                            <input name="numeroPiece" class="form-control form-control-sm"
                                   placeholder="N° de facture" />
                        </div>
                        <div class="col-md-4">
                            <input name="emetteur" class="form-control form-control-sm"
                                   placeholder="Fournisseur" />
                        </div>
                        <div class="col-md-4">
                            <input name="montantFacture" type="number" step="1" min="0"
                                   class="form-control form-control-sm" placeholder="Montant de la facture (Ar)" />
                        </div>
                    </div>

                    <button class="btn btn-primary">
                        <i class="fa-solid fa-paper-plane me-1"></i> Envoyer le compte rendu et les factures
                    </button>
                </form>
            }
            else
            {
                <p class="text-muted mb-0">En attente du compte rendu du chef de chantier.</p>
            }
        }
        else
        {
            <p class="mb-3" style="white-space:pre-wrap">@Model.RapportRealisation</p>
            <div class="small text-muted mb-3">
                Rendu le @Model.DateRapport?.ToLocalTime().ToString("dd/MM/yyyy")
                @if (Model.Statut == StatutPrevision.Cloturee)
                {
                    <span>· Réceptionné par @Model.RapportValideParId le @Model.DateValidationRapport?.ToLocalTime().ToString("dd/MM/yyyy")</span>
                }
            </div>

            @if (Model.Statut == StatutPrevision.RapportSoumis && User.IsInRole("Administrateur"))
            {
                <form asp-action="ReceptionnerTravaux" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button class="btn btn-success"><i class="fa-solid fa-check-double me-1"></i> Réceptionner les travaux</button>
                </form>
                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalRefusRapport">
                    <i class="fa-solid fa-rotate-left me-1"></i> Renvoyer au chef
                </button>
            }
        }
    </div>

    @if (Model.Statut == StatutPrevision.RapportSoumis && User.IsInRole("Administrateur"))
    {
        <div class="modal fade" id="modalRefusRapport" tabindex="-1">
            <div class="modal-dialog">
                <form asp-action="RefuserRapport" method="post" class="modal-content">
                    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
                    <div class="modal-header"><h6 class="modal-title">Renvoyer le compte rendu</h6>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                    <div class="modal-body">
                        <label class="form-label">Ce qui manque / à corriger</label>
                        <textarea name="motif" class="form-control" rows="3" required></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-danger">Renvoyer</button>
                    </div>
                </form>
            </div>
        </div>
    }
}

<!-- Modale de refus -->
<div class="modal fade" id="modalRefus" tabindex="-1">
  <div class="modal-dialog">
    <form asp-action="Refuser" method="post" class="modal-content">
      @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" />
      <div class="modal-header"><h6 class="modal-title">Refuser la prévision</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <label class="form-label">Motif du refus</label>
        <textarea name="motif" class="form-control" rows="3" required></textarea>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Annuler</button>
        <button type="submit" class="btn btn-danger">Confirmer le refus</button>
      </div>
    </form>
  </div>
</div>

<a asp-action="Index" class="btn btn-light mt-3">Retour à la liste</a>
