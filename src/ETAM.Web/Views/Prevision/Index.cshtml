@model List<ETAM.Domain.Entities.PrevisionJournaliere>
@{ ViewData["Title"] = "Prévisions journalières"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">@Model.Count prévision(s)</p>
    <div class="d-flex align-items-center">
        @if (User.IsInRole("Administrateur") || User.IsInRole("Correspondant"))
        {
            <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i> Nouvelle prévision</a>
        }
        <partial name="_BoutonsExport" model='new ETAM.Web.Models.ExportLiens("Prevision", "ExportListe")' />
    </div>
</div>
<div class="etam-card p-3">
<table class="table table-hover align-middle datatable">
    <thead><tr>
        <th>Référence</th><th>Chantier</th><th>Date</th><th>Statut</th>
        <th class="text-end">Total</th><th style="width:280px">Workflow</th>
    </tr></thead>
    <tbody>
    @foreach (var p in Model)
    {
        var badge = p.Statut switch {
            StatutPrevision.Brouillon => "bg-secondary",
            StatutPrevision.Soumise => "bg-info text-dark",
            StatutPrevision.ValideeResponsableFinancier => "bg-primary",
            StatutPrevision.ValideeAdministrateur => "bg-warning text-dark",
            StatutPrevision.Executee => "bg-success",
            StatutPrevision.Refusee => "bg-danger",
            _ => "bg-secondary" };
        <tr>
            <td class="fw-semibold"><a asp-action="Details" asp-route-id="@p.Id" class="text-decoration-none">@p.Reference</a></td>
            <td>@p.Chantier?.Nom</td>
            <td>@p.DatePrevision.ToString("dd/MM/yyyy")</td>
            <td><span class="badge badge-statut @badge">@p.Statut</span></td>
            <td class="text-end">@p.Total.ToString("N0") Ar</td>
            <td class="text-end text-nowrap">
                @{
                    var (libelle, couleur) = p.Statut switch
                    {
                        StatutPrevision.Brouillon => ("Examiner / Soumettre", "btn-outline-info"),
                        StatutPrevision.Soumise => ("Examiner / Valider", "btn-outline-primary"),
                        StatutPrevision.ValideeResponsableFinancier => ("Examiner / Valider", "btn-outline-warning"),
                        StatutPrevision.ValideeAdministrateur => ("Examiner / Exécuter", "btn-success"),
                        _ => ("Détails", "btn-light")
                    };
                }
                @if (p.EstModifiable && (User.IsInRole("Administrateur") || User.IsInRole("Correspondant")))
                {
                    <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-light"><i class="fa-solid fa-pen me-1"></i> Modifier</a>
                }
                <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm @couleur">
                    <i class="fa-solid fa-eye me-1"></i>@libelle
                </a>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
@section Scripts {
<script>
  document.querySelectorAll('.js-confirm').forEach(f=>{
    f.addEventListener('submit',e=>{
      e.preventDefault();
      Swal.fire({title:'Confirmer ?',icon:'question',showCancelButton:true,
        confirmButtonText:'Oui',cancelButtonText:'Annuler',confirmButtonColor:'#2563eb'})
        .then(r=>{ if(r.isConfirmed) f.submit(); });
    });
  });
</script>
}
