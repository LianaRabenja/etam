@model ETAM.Domain.Entities.PrevisionJournaliere
@using ETAM.Domain.Enums
@*
    La caisse du chantier, présentée comme la fiche de stock du magasinier :
    une entrée, des sorties, un reste. Rien d'autre.
*@

@if (Model.Statut == StatutPrevision.Executee || Model.Statut == StatutPrevision.RapportSoumis
     || Model.Statut == StatutPrevision.Cloturee)
{
    var reste = Model.PlafondDuJour - Model.MontantDecaisse;
    var sorties = Model.Decaissements.Where(x => !x.IsDeleted).OrderBy(x => x.Date).ToList();

    <div class="etam-card p-4 mb-3">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="mb-0">La caisse du chantier</h6>
            @if (Model.PeutDecaisser
                 && (User.IsInRole("Administrateur") || User.IsInRole("Correspondant") || User.IsInRole("Chef de chantier")))
            {
                <a asp-controller="Decaissement" asp-action="Create" asp-route-previsionId="@Model.Id"
                   class="btn btn-primary btn-sm">
                    <i class="fa-solid fa-plus me-1"></i> Noter une sortie
                </a>
            }
        </div>

        @* ---- Le seul chiffre à retenir ---- *@
        <div class="text-center py-3 mb-3 rounded"
             style="background:@(reste > 0 ? "#f0fdf4" : "#f8fafc")">
            <div class="text-muted small">Reste en main</div>
            <div class="fw-bold" style="font-size:2rem;color:@(reste > 0 ? "#047857" : "#64748b")">
                @reste.ToString("N0") Ar
            </div>
        </div>

        @* ---- La fiche : entrée, sortie, reste ---- *@
        <table class="table table-sm align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width:110px">Date</th>
                    <th>Motif</th>
                    <th class="text-end" style="width:120px">Entrée</th>
                    <th class="text-end" style="width:120px">Sortie</th>
                    <th class="text-end" style="width:130px">Reste</th>
                </tr>
            </thead>
            <tbody>
            @{
                var solde = 0m;
            }

            @if (Model.ReportVeille > 0)
            {
                solde += Model.ReportVeille;
                <tr>
                    <td class="small text-muted">@Model.DatePrevision.ToString("dd/MM")</td>
                    <td>Reste de la journée précédente</td>
                    <td class="text-end text-success">@Model.ReportVeille.ToString("N0")</td>
                    <td></td>
                    <td class="text-end fw-semibold">@solde.ToString("N0")</td>
                </tr>
            }

            @if (Model.EstAccuseeReception)
            {
                solde += Model.Total;
                <tr>
                    <td class="small text-muted">@Model.DateAccuseReception?.ToString("dd/MM HH:mm")</td>
                    <td>
                        Argent reçu à la banque
                        <span class="text-muted small">— signé par @Model.AccuseNomSignataire</span>
                    </td>
                    <td class="text-end text-success fw-semibold">@Model.Total.ToString("N0")</td>
                    <td></td>
                    <td class="text-end fw-semibold">@solde.ToString("N0")</td>
                </tr>
            }
            else
            {
                <tr class="table-warning">
                    <td class="small text-muted">—</td>
                    <td colspan="4">
                        <strong>@Model.Total.ToString("N0") Ar</strong> attendus.
                        L'argent est encore en banque : il ne sortira qu'à la signature du reçu.
                    </td>
                </tr>
            }

            @foreach (var d in sorties)
            {
                solde -= d.Montant;
                <tr>
                    <td class="small text-muted">@d.Date.ToString("dd/MM HH:mm")</td>
                    <td>
                        @d.Motif
                        <span class="text-muted small">— @d.Beneficiaire</span>
                    </td>
                    <td></td>
                    <td class="text-end text-danger">@d.Montant.ToString("N0")</td>
                    <td class="text-end fw-semibold">@solde.ToString("N0")</td>
                </tr>
            }
            </tbody>
        </table>

        @if (Model.EstAccuseeReception && !sorties.Any())
        {
            <p class="text-muted small mt-3 mb-0">
                Aucune sortie notée. Cliquez sur « Noter une sortie » à chaque fois que
                le chef donne de l'argent à quelqu'un.
            </p>
        }
    </div>

    @* ---- Signature du reçu ---- *@
    @if (!Model.DateAccuseReception.HasValue
         && (User.IsInRole("Administrateur") || User.IsInRole("Correspondant") || User.IsInRole("Chef de chantier")))
    {
        <div class="etam-card p-4 mb-3 border-warning">
            <h6 class="text-warning mb-2">
                <i class="fa-solid fa-signature me-1"></i> Signer le reçu pour retirer l'argent
            </h6>
            <form asp-action="AccuserReception" asp-route-id="@Model.Id" method="post"
                  class="row g-2 align-items-end">
                @Html.AntiForgeryToken()
                <div class="col-md-6">
                    <label class="form-label small">Nom de la personne qui reçoit l'argent</label>
                    <input name="nomSignataire" class="form-control" required placeholder="Nom et prénom" />
                </div>
                <div class="col-md-6">
                    <button class="btn btn-warning">
                        Je reconnais avoir reçu @Model.Total.ToString("N0") Ar
                    </button>
                </div>
            </form>
        </div>
    }
    else if (Model.EstAccuseeReception)
    {
        <div class="mb-3">
            <a asp-controller="Prevision" asp-action="AccuseRecu" asp-route-id="@Model.Id"
               target="_blank" class="btn btn-sm btn-outline-secondary">
                <i class="fa-solid fa-print me-1"></i> Imprimer le reçu
            </a>
        </div>
    }

    @* ---- Factures déjà jointes ---- *@
    @if (Model.PiecesJointes.Any(x => !x.IsDeleted))
    {
        <div class="etam-card p-4 mb-3">
            <h6 class="mb-3">Factures</h6>
            <div class="row g-2">
                @foreach (var pj in Model.PiecesJointes.Where(x => !x.IsDeleted).OrderBy(x => x.DateAjout))
                {
                    <div class="col-6 col-md-3">
                        <a asp-controller="PieceJointe" asp-action="Voir" asp-route-id="@pj.Id" target="_blank"
                           class="d-block border rounded p-2 text-decoration-none text-body h-100">
                            @if (pj.EstImage)
                            {
                                <img src="@Url.Action("Voir", "PieceJointe", new { id = pj.Id })"
                                     class="img-fluid rounded mb-2"
                                     style="max-height:120px;object-fit:cover;width:100%" alt="@pj.NomFichier" />
                            }
                            else
                            {
                                <div class="text-center py-4 text-danger"><i class="fa-solid fa-file-pdf fa-2x"></i></div>
                            }
                            <div class="small text-truncate">@(pj.NumeroPiece ?? pj.NomFichier)</div>
                            @if (pj.MontantFacture.HasValue)
                            {
                                <div class="small fw-semibold">@pj.MontantFacture.Value.ToString("N0") Ar</div>
                            }
                        </a>
                    </div>
                }
            </div>
        </div>
    }
}
