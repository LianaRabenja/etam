@model ETAM.Domain.Entities.PrevisionJournaliere
@using ETAM.Domain.Enums
@*
    Bloc « argent de la journée » : accusé de réception, plafond du jour avec report
    de la veille, décaissements réels et justificatifs.
    Inséré dans Prevision/Details.cshtml.
*@

@if (Model.Statut == StatutPrevision.Executee || Model.Statut == StatutPrevision.RapportSoumis
     || Model.Statut == StatutPrevision.Cloturee)
{
    var reliquat = Model.PlafondDuJour - Model.MontantDecaisse;
    var pct = Model.PourcentageDecaisse;

    <!-- ===== L'argent de la journée ===== -->
    <div class="etam-card p-4 mb-3">
        <h6 class="mb-3">L'argent de cette journée</h6>

        <div class="row text-center g-3">
            <div class="col-6 col-md-3">
                <div class="text-muted small">Demandé</div>
                <div class="fs-6 fw-semibold">@Model.Total.ToString("N0") Ar</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-muted small">Reporté de la veille</div>
                <div class="fs-6 fw-semibold @(Model.ReportVeille > 0 ? "text-info" : "text-muted")">
                    @(Model.ReportVeille > 0 ? "+ " + Model.ReportVeille.ToString("N0") + " Ar" : "aucun")
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-muted small">Plafond du jour</div>
                <div class="fs-5 fw-bold text-primary">@Model.PlafondDuJour.ToString("N0") Ar</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-muted small">Reste à dépenser</div>
                <div class="fs-5 fw-bold @(reliquat <= 0 ? "text-muted" : "text-success")">
                    @reliquat.ToString("N0") Ar
                </div>
            </div>
        </div>

        <div class="progress mt-3" style="height:10px">
            <div class="progress-bar @(pct >= 100 ? "bg-danger" : pct >= 50 ? "bg-warning" : "bg-success")"
                 style="width:@(Math.Min(pct, 100).ToString("F0"))%"></div>
        </div>
        <div class="small text-muted mt-1">
            Sorti : @Model.MontantDecaisse.ToString("N0") Ar — @pct.ToString("F1") % du plafond.
            @if (reliquat > 0 && Model.Statut == StatutPrevision.Cloturee)
            {
                <span class="text-info">Ce reste a été reporté sur la journée suivante.</span>
            }
        </div>
    </div>

    <!-- ===== Accusé de réception ===== -->
    @if (!Model.DateAccuseReception.HasValue)
    {
        <div class="etam-card p-4 mb-3 border-warning">
            <h6 class="text-warning mb-2">
                <i class="fa-solid fa-hand-holding-dollar me-1"></i>
                Réception de l'argent à signer
            </h6>
            <p class="text-muted small mb-3">
                Tant que la réception n'est pas signée, aucune sortie d'argent n'est possible
                sur cette prévision.
            </p>

            @if (User.IsInRole("Administrateur") || User.IsInRole("Correspondant") || User.IsInRole("Chef de chantier"))
            {
                <form asp-action="AccuserReception" asp-route-id="@Model.Id" method="post"
                      class="row g-2 align-items-end">
                    @Html.AntiForgeryToken()
                    <div class="col-md-6">
                        <label class="form-label small">Nom de la personne qui reçoit l'argent</label>
                        <input name="nomSignataire" class="form-control" required
                               placeholder="Nom et prénom du chef de chantier" />
                    </div>
                    <div class="col-md-4">
                        <button class="btn btn-warning">
                            <i class="fa-solid fa-signature me-1"></i>
                            Je reconnais avoir reçu @Model.PlafondDuJour.ToString("N0") Ar
                        </button>
                    </div>
                </form>
            }
        </div>
    }
    else
    {
        <div class="alert alert-success d-flex justify-content-between align-items-center">
            <div>
                <i class="fa-solid fa-circle-check me-1"></i>
                <strong>Réception signée par @Model.AccuseNomSignataire</strong>
                le @Model.DateAccuseReception?.ToString("dd/MM/yyyy à HH:mm")
                pour @Model.MontantAccuse?.ToString("N0") Ar.
            </div>
            <a asp-controller="Prevision" asp-action="AccuseRecu" asp-route-id="@Model.Id"
               target="_blank" class="btn btn-sm btn-outline-success">
                <i class="fa-solid fa-print me-1"></i> Imprimer l'accusé
            </a>
        </div>
    }

    <!-- ===== Décaissements ===== -->
    <div class="etam-card p-4 mb-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h6 class="mb-0">Sorties d'argent</h6>
            @if (Model.PeutDecaisser
                 && (User.IsInRole("Administrateur") || User.IsInRole("Correspondant") || User.IsInRole("Chef de chantier")))
            {
                <a asp-controller="Decaissement" asp-action="Create" asp-route-previsionId="@Model.Id"
                   class="btn btn-primary btn-sm">
                    <i class="fa-solid fa-plus me-1"></i> Nouvelle sortie
                </a>
            }
        </div>

        @if (!Model.Decaissements.Any(d => !d.IsDeleted))
        {
            <p class="text-muted mb-0">
                Aucune sortie d'argent pour l'instant. Le compte n'a pas encore été débité.
            </p>
        }
        else
        {
            <table class="table table-sm align-middle">
                <thead><tr>
                    <th>Date</th><th>Bénéficiaire</th><th>Motif</th>
                    <th class="text-end">Montant</th><th>Justificatif</th>
                </tr></thead>
                <tbody>
                @foreach (var d in Model.Decaissements.Where(x => !x.IsDeleted).OrderBy(x => x.Date))
                {
                    <tr>
                        <td class="small">@d.Date.ToString("dd/MM HH:mm")</td>
                        <td class="fw-semibold">@d.Beneficiaire</td>
                        <td class="small">@d.Motif</td>
                        <td class="text-end fw-semibold">@d.Montant.ToString("N0") Ar</td>
                        <td class="small text-muted">@d.Reference</td>
                    </tr>
                }
                </tbody>
                <tfoot><tr class="fw-semibold">
                    <td colspan="3">Total sorti</td>
                    <td class="text-end">@Model.MontantDecaisse.ToString("N0") Ar</td>
                    <td></td>
                </tr></tfoot>
            </table>
        }
    </div>

    <!-- ===== Justificatifs ===== -->
    <div class="etam-card p-4 mb-3">
        <h6 class="mb-1">Factures et justificatifs</h6>
        <p class="text-muted small mb-3">
            Ils s'ajoutent en bas de cette page, en même temps que le compte rendu des travaux.
        </p>

        @if (Model.PiecesJointes.Any(x => !x.IsDeleted))
        {
            <div class="row g-2 mb-3">
                @foreach (var pj in Model.PiecesJointes.Where(x => !x.IsDeleted).OrderBy(x => x.DateAjout))
                {
                    <div class="col-6 col-md-3">
                        <div class="border rounded p-2 h-100">
                            @if (pj.EstImage)
                            {
                                <a asp-controller="PieceJointe" asp-action="Voir" asp-route-id="@pj.Id" target="_blank">
                                    <img src="@Url.Action("Voir", "PieceJointe", new { id = pj.Id })"
                                         class="img-fluid rounded mb-2" style="max-height:130px;object-fit:cover;width:100%"
                                         alt="@pj.NomFichier" />
                                </a>
                            }
                            else
                            {
                                <a asp-controller="PieceJointe" asp-action="Voir" asp-route-id="@pj.Id" target="_blank"
                                   class="d-block text-center py-4 text-danger">
                                    <i class="fa-solid fa-file-pdf fa-2x"></i>
                                </a>
                            }
                            <div class="small text-truncate" title="@pj.NomFichier">@pj.NomFichier</div>
                            @if (!string.IsNullOrEmpty(pj.NumeroPiece))
                            {
                                <div class="small text-muted">N° @pj.NumeroPiece</div>
                            }
                            @if (pj.MontantFacture.HasValue)
                            {
                                <div class="small fw-semibold">@pj.MontantFacture.Value.ToString("N0") Ar</div>
                            }
                            <div class="small text-muted">@pj.TailleLisible</div>

                            @if (User.IsInRole("Administrateur") || User.IsInRole("Correspondant"))
                            {
                                <form asp-controller="PieceJointe" asp-action="Supprimer" asp-route-id="@pj.Id"
                                      method="post" onsubmit="return confirm('Retirer ce justificatif ?');">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-sm btn-outline-danger w-100 mt-1">Retirer</button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="text-muted mb-0">
                Aucune facture pour l'instant. Elles se joignent en bas de page,
                avec le compte rendu des travaux.
            </p>
        }
    </div>
}
