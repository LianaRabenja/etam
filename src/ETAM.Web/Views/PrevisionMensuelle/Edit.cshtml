@model ETAM.Domain.Entities.PrevisionMensuelle
@{
    ViewData["Title"] = $"Modifier l'enveloppe de {Model.Libelle}";
    var budgetProjet = ViewBag.BudgetProjet as decimal? ?? 0m;
    var dejaEngage   = ViewBag.DejaEngage   as decimal? ?? 0m;
    var plafond      = budgetProjet - dejaEngage;
    var lignes       = Model.Lignes?.Where(l => !l.IsDeleted).ToList()
                       ?? new List<ETAM.Domain.Entities.PrevisionMensuelleLigne>();
}

<div class="etam-card p-4">
    <h5 class="mb-1">Modifier l'enveloppe de @Model.Libelle</h5>
    <p class="text-muted small mb-4">
        Chantier : <strong>@Model.Chantier?.Nom</strong> · Référence @Model.Reference
    </p>

    <div class="alert alert-light border small">
        Le chantier, l'année et le mois ne se modifient pas ici : la base n'accepte qu'une
        enveloppe par chantier et par mois. Pour changer de mois, supprimez celle-ci et
        créez la bonne.
        @if (plafond > 0)
        {
            <br /><strong>Ce mois ne peut pas dépasser @plafond.ToString("N0") Ar</strong>
            <text> — budget projet @budgetProjet.ToString("N0") Ar, dont @dejaEngage.ToString("N0") Ar déjà répartis sur les autres mois.</text>
        }
    </div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Montant prévu pour le mois (Ar)</label>
                <input name="montantPrevu" type="number" step="1" min="1" class="form-control form-control-lg"
                       value="@Model.MontantPrevu.ToString(System.Globalization.CultureInfo.InvariantCulture)" required />
                <div class="form-text">
                    Report du mois précédent : @Model.ReportMoisPrecedent.ToString("N0") Ar
                    (ajouté automatiquement, il ne compte pas dans le budget du projet).
                </div>
            </div>

            <div class="col-md-6">
                <label class="form-label">Observation</label>
                <input name="observation" class="form-control" value="@Model.Observation" placeholder="Facultatif" />
            </div>
        </div>

        <hr class="my-4" />

        <h6>Répartition par rubrique <span class="text-muted fw-normal">(facultatif)</span></h6>
        <p class="text-muted small">
            Permet de comparer plus tard le prévu et le dépensé, poste par poste.
            Videz une ligne ou mettez-la à 0 pour la supprimer.
        </p>

        <table class="table table-sm align-middle" id="tableRubriques">
            <thead><tr><th>Rubrique</th><th style="width:220px">Montant (Ar)</th><th style="width:60px"></th></tr></thead>
            <tbody>
            @if (lignes.Count > 0)
            {
                foreach (var l in lignes)
                {
                    <tr>
                        <td><input name="rubriques" class="form-control" value="@l.Rubrique" /></td>
                        <td><input name="montantsRubriques" type="number" step="1" min="0" class="form-control js-montant"
                                   value="@l.Montant.ToString(System.Globalization.CultureInfo.InvariantCulture)" /></td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    onclick="this.closest('tr').remove(); majTotal();">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
            else
            {
                foreach (var r in new[] { "Approvisionnement", "Main d'œuvre", "Transport", "Imprévus" })
                {
                    <tr>
                        <td><input name="rubriques" class="form-control" value="@r" /></td>
                        <td><input name="montantsRubriques" type="number" step="1" min="0" class="form-control js-montant" value="0" /></td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-danger"
                                    onclick="this.closest('tr').remove(); majTotal();">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
            </tbody>
            <tfoot><tr>
                <th class="text-end">Total réparti</th>
                <th class="text-end" id="totalRubriques">0</th><th></th>
            </tr></tfoot>
        </table>

        <button type="button" class="btn btn-sm btn-outline-secondary mb-4" onclick="ajouterRubrique()">
            <i class="fa-solid fa-plus me-1"></i> Ajouter une rubrique
        </button>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Enregistrer les modifications</button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Annuler</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
function majTotal() {
    let somme = 0;
    document.querySelectorAll('.js-montant').forEach(i => somme += parseFloat(i.value) || 0);
    document.getElementById('totalRubriques').textContent =
        new Intl.NumberFormat('fr-FR').format(Math.round(somme));
}

function ajouterRubrique() {
    const corps = document.querySelector('#tableRubriques tbody');
    const ligne = document.createElement('tr');
    ligne.innerHTML =
        '<td><input name="rubriques" class="form-control" placeholder="Nom de la rubrique" /></td>' +
        '<td><input name="montantsRubriques" type="number" step="1" min="0" class="form-control js-montant" value="0" /></td>' +
        '<td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger" ' +
        'onclick="this.closest(\'tr\').remove(); majTotal();"><i class="fa-solid fa-xmark"></i></button></td>';
    corps.appendChild(ligne);
    majTotal();
}

document.addEventListener('input', majTotal);
majTotal();
</script>
}
