@{ ViewData["Title"] = "Rapports"; }
<p class="text-muted">Générez et exportez les états de l'entreprise.</p>
<div class="row g-4">
    <div class="col-md-4">
        <div class="etam-card p-4 text-center">
            <i class="fa-solid fa-helmet-safety text-primary" style="font-size:2rem"></i>
            <h6 class="fw-bold mt-3">Rapport Chantiers</h6>
            <p class="text-muted small">État budgétaire et avancement de tous les chantiers.</p>
            <a asp-action="ChantiersExcel" class="btn btn-success btn-sm"><i class="fa-solid fa-file-excel me-1"></i> Excel</a>
            <a asp-action="ChantiersPdf" class="btn btn-danger btn-sm"><i class="fa-solid fa-file-pdf me-1"></i> PDF</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="etam-card p-4 text-center">
            <i class="fa-solid fa-wallet text-primary" style="font-size:2rem"></i>
            <h6 class="fw-bold mt-3">Rapport Budgets</h6>
            <p class="text-muted small">Consommation Budget Comptes &amp; Matériel.</p>
            <a href="/BudgetComptes/Index" class="btn btn-light btn-sm">Consulter</a>
        </div>
    </div>
    <div class="col-md-4">
        <div class="etam-card p-4 text-center">
            <i class="fa-solid fa-receipt text-primary" style="font-size:2rem"></i>
            <h6 class="fw-bold mt-3">Rapport Dépenses</h6>
            <p class="text-muted small">Historique des dépenses par chantier.</p>
            <a href="/Depenses/Index" class="btn btn-light btn-sm">Consulter</a>
        </div>
    </div>
</div>
