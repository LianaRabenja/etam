@model ETAM.Web.Models.RapportTravailFormViewModel
@{
    ViewData["Title"] = "Nouveau rapport de travail";
    var chantiers = ViewBag.Chantiers as IEnumerable<ETAM.Domain.Entities.Chantier>;
}
<div class="etam-card p-4 mb-3">
<form asp-action="Create" method="post" id="formRapport">
    <div asp-validation-summary="ModelOnly" class="text-danger small"></div>
    <h6 class="fw-bold">1. Informations générales</h6>
    <div class="row g-3 mb-3">
        <div class="col-md-4"><label class="form-label">Chantier</label>
            <select asp-for="ChantierId" class="form-select" required>
                <option value="">-- choisir --</option>
                @foreach (var c in chantiers ?? Enumerable.Empty<ETAM.Domain.Entities.Chantier>())
                { <option value="@c.Id">@c.Nom (@c.Code)</option> }
            </select></div>
        <div class="col-md-2"><label class="form-label">N° du rapport</label><input asp-for="Numero" class="form-control" placeholder="06" required /></div>
        <div class="col-md-3"><label class="form-label">Période du</label><input asp-for="PeriodeDebut" type="date" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">Au</label><input asp-for="PeriodeFin" type="date" class="form-control" /></div>

        <div class="col-md-4"><label class="form-label">Lieu</label><input asp-for="Lieu" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">Entreprise exécutante</label><input asp-for="EntrepriseExecutante" class="form-control" /></div>
        <div class="col-md-4"><label class="form-label">Conducteur de travaux</label><input asp-for="ConducteurTravaux" class="form-control" /></div>

        <div class="col-md-3"><label class="form-label">Effectif cadres</label><input asp-for="EffectifCadres" type="number" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">Effectif ouvriers</label><input asp-for="EffectifOuvriers" type="number" class="form-control" /></div>
        <div class="col-md-3"><label class="form-label">Horaire matin</label><input asp-for="HoraireMatin" class="form-control" placeholder="06h-11h30" /></div>
        <div class="col-md-3"><label class="form-label">Horaire après-midi</label><input asp-for="HoraireApresMidi" class="form-control" placeholder="13h-18h" /></div>
        <div class="col-12"><label class="form-label">Conditions météo</label><input asp-for="ConditionsMeteo" class="form-control" /></div>
    </div>

    <h6 class="fw-bold">2. Avancement des travaux</h6>
    <table class="table table-sm align-middle" id="tblAvancement">
        <thead><tr><th>Zone / Ouvrage</th><th>Travaux réalisés</th><th>Niveau d'avancement</th><th>Observations</th><th></th></tr></thead>
        <tbody></tbody>
    </table>
    <button type="button" class="btn btn-sm btn-light mb-3" id="btnAddAvancement"><i class="fa-solid fa-plus me-1"></i> Ajouter une ligne</button>

    <h6 class="fw-bold">3. Résumé des travaux effectués suivant planning</h6>
    <div class="mb-3"><textarea asp-for="ResumeSuiviPlanning" class="form-control" rows="3"></textarea></div>

    <h6 class="fw-bold">4. Suivi des matériaux</h6>
    <table class="table table-sm align-middle" id="tblMateriaux">
        <thead><tr><th>Matériau</th><th>Unité</th><th>Utilisé</th><th>Stock initial</th><th>Entrée</th><th>Stock restant</th><th>Observations</th><th></th></tr></thead>
        <tbody></tbody>
    </table>
    <button type="button" class="btn btn-sm btn-light mb-3" id="btnAddMateriau"><i class="fa-solid fa-plus me-1"></i> Ajouter une ligne</button>

    <h6 class="fw-bold">5. Matériels et équipements</h6>
    <table class="table table-sm align-middle" id="tblEquipements">
        <thead><tr><th>Équipement</th><th>État</th><th>Observation</th><th></th></tr></thead>
        <tbody></tbody>
    </table>
    <button type="button" class="btn btn-sm btn-light mb-3" id="btnAddEquipement"><i class="fa-solid fa-plus me-1"></i> Ajouter une ligne</button>

    <div class="row g-3 mb-3">
        <div class="col-md-6"><label class="form-label fw-bold">6. Problèmes rencontrés</label>
            <textarea asp-for="ProblemesRencontres" class="form-control" rows="3"></textarea></div>
        <div class="col-md-6"><label class="form-label fw-bold">7. Suggestions</label>
            <textarea asp-for="Suggestions" class="form-control" rows="3"></textarea></div>
    </div>

    <div class="mt-3">
        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check me-1"></i> Enregistrer (brouillon)</button>
        <a asp-action="Index" class="btn btn-light">Annuler</a>
    </div>
</form>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
  let ia = 0, im = 0, ie = 0;

  function rowAvancement(){
    const r = `<tr>
      <td><input name="LignesAvancement[${ia}].Zone" class="form-control form-control-sm" required></td>
      <td><input name="LignesAvancement[${ia}].TravauxRealises" class="form-control form-control-sm" required></td>
      <td><input name="LignesAvancement[${ia}].NiveauAvancement" class="form-control form-control-sm" required></td>
      <td><input name="LignesAvancement[${ia}].Observations" class="form-control form-control-sm"></td>
      <td><button type="button" class="btn btn-sm btn-outline-danger js-del"><i class="fa-solid fa-trash"></i></button></td>
    </tr>`;
    document.querySelector('#tblAvancement tbody').insertAdjacentHTML('beforeend', r); ia++;
  }
  function rowMateriau(){
    const r = `<tr>
      <td><input name="LignesMateriaux[${im}].Materiau" class="form-control form-control-sm" required></td>
      <td><input name="LignesMateriaux[${im}].Unite" class="form-control form-control-sm"></td>
      <td><input name="LignesMateriaux[${im}].QuantiteUtilisee" type="number" step="0.01" class="form-control form-control-sm" value="0"></td>
      <td><input name="LignesMateriaux[${im}].StockInitial" type="number" step="0.01" class="form-control form-control-sm" value="0"></td>
      <td><input name="LignesMateriaux[${im}].Entree" type="number" step="0.01" class="form-control form-control-sm" value="0"></td>
      <td><input name="LignesMateriaux[${im}].StockRestant" type="number" step="0.01" class="form-control form-control-sm" value="0"></td>
      <td><input name="LignesMateriaux[${im}].Observations" class="form-control form-control-sm"></td>
      <td><button type="button" class="btn btn-sm btn-outline-danger js-del"><i class="fa-solid fa-trash"></i></button></td>
    </tr>`;
    document.querySelector('#tblMateriaux tbody').insertAdjacentHTML('beforeend', r); im++;
  }
  function rowEquipement(){
    const r = `<tr>
      <td><input name="LignesEquipements[${ie}].Equipement" class="form-control form-control-sm" required></td>
      <td><input name="LignesEquipements[${ie}].Etat" class="form-control form-control-sm"></td>
      <td><input name="LignesEquipements[${ie}].Observation" class="form-control form-control-sm"></td>
      <td><button type="button" class="btn btn-sm btn-outline-danger js-del"><i class="fa-solid fa-trash"></i></button></td>
    </tr>`;
    document.querySelector('#tblEquipements tbody').insertAdjacentHTML('beforeend', r); ie++;
  }

  document.getElementById('btnAddAvancement').addEventListener('click', rowAvancement);
  document.getElementById('btnAddMateriau').addEventListener('click', rowMateriau);
  document.getElementById('btnAddEquipement').addEventListener('click', rowEquipement);
  document.addEventListener('click', e=>{ if(e.target.closest('.js-del')) e.target.closest('tr').remove(); });

  rowAvancement(); rowMateriau(); rowEquipement();
</script>
}
