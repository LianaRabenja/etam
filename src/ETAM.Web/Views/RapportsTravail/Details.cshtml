@model ETAM.Domain.Entities.RapportTravail
@using ETAM.Domain.Enums
@{
    ViewData["Title"] = $"Rapport de travail n°{Model.Numero}";
    var badge = Model.Statut switch {
        StatutRapportTravail.Brouillon => "bg-secondary",
        StatutRapportTravail.Soumis => "bg-info text-dark",
        StatutRapportTravail.Valide => "bg-success",
        StatutRapportTravail.Refuse => "bg-danger",
        _ => "bg-secondary" };
}
<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h4 class="fw-bold mb-1">Rapport hebdomadaire n°@Model.Numero <span class="badge badge-statut @badge">@Model.Statut</span></h4>
        <span class="text-muted">@Model.Chantier?.Nom · Période du @Model.PeriodeDebut.ToString("dd/MM/yyyy") au @Model.PeriodeFin.ToString("dd/MM/yyyy")</span>
    </div>
    <div class="text-nowrap">
        @if (Model.EstModifiable && (User.IsInRole("Administrateur") || User.IsInRole("Correspondant")))
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-light"><i class="fa-solid fa-pen"></i> Modifier</a>
            <form asp-action="Soumettre" asp-route-id="@Model.Id" method="post" class="d-inline js-confirm">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-paper-plane me-1"></i> Soumettre</button>
            </form>
        }
        @if (Model.Statut == StatutRapportTravail.Soumis && User.IsInRole("Administrateur"))
        {
            <form asp-action="Valider" asp-route-id="@Model.Id" method="post" class="d-inline js-confirm">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success"><i class="fa-solid fa-check me-1"></i> Valider</button>
            </form>
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#modalRefus">
                <i class="fa-solid fa-xmark me-1"></i> Refuser
            </button>
        }
        <a asp-action="Index" class="btn btn-light">Retour</a>
    </div>
</div>

@if (Model.Statut == StatutRapportTravail.Refuse && !string.IsNullOrWhiteSpace(Model.MotifRefus))
{
    <div class="alert alert-danger"><strong>Motif du refus :</strong> @Model.MotifRefus</div>
}

<div class="etam-card p-4 mb-3">
    <h6 class="fw-bold">1. Informations générales</h6>
    <div class="row">
        <div class="col-md-4 mb-2"><small class="text-muted">Lieu</small><div>@Model.Lieu</div></div>
        <div class="col-md-4 mb-2"><small class="text-muted">Entreprise exécutante</small><div>@Model.EntrepriseExecutante</div></div>
        <div class="col-md-4 mb-2"><small class="text-muted">Conducteur de travaux</small><div>@Model.ConducteurTravaux</div></div>
        <div class="col-md-3 mb-2"><small class="text-muted">Effectif cadres</small><div>@Model.EffectifCadres</div></div>
        <div class="col-md-3 mb-2"><small class="text-muted">Effectif ouvriers</small><div>@Model.EffectifOuvriers</div></div>
        <div class="col-md-3 mb-2"><small class="text-muted">Horaire matin</small><div>@Model.HoraireMatin</div></div>
        <div class="col-md-3 mb-2"><small class="text-muted">Horaire après-midi</small><div>@Model.HoraireApresMidi</div></div>
        <div class="col-12 mb-2"><small class="text-muted">Conditions météo</small><div>@Model.ConditionsMeteo</div></div>
    </div>
</div>

<div class="etam-card p-4 mb-3">
    <h6 class="fw-bold">2. Avancement des travaux</h6>
    <table class="table table-sm align-middle">
        <thead><tr><th>Zone / Ouvrage</th><th>Travaux réalisés</th><th>Niveau d'avancement</th><th>Observations</th></tr></thead>
        <tbody>
        @foreach (var l in Model.LignesAvancement)
        {
            <tr><td class="fw-semibold">@l.Zone</td><td>@l.TravauxRealises</td><td>@l.NiveauAvancement</td><td class="small text-muted">@l.Observations</td></tr>
        }
        @if (!Model.LignesAvancement.Any()) { <tr><td colspan="4" class="text-muted text-center">Aucune ligne.</td></tr> }
        </tbody>
    </table>
</div>

<div class="etam-card p-4 mb-3">
    <h6 class="fw-bold">3. Résumé des travaux effectués suivant planning</h6>
    <p class="mb-0" style="white-space:pre-wrap">@Model.ResumeSuiviPlanning</p>
</div>

<div class="etam-card p-4 mb-3">
    <h6 class="fw-bold">4. Suivi des matériaux</h6>
    <table class="table table-sm align-middle">
        <thead><tr><th>Matériau</th><th>Unité</th><th class="text-end">Utilisé</th><th class="text-end">Stock initial</th><th class="text-end">Entrée</th><th class="text-end">Stock restant</th><th>Observations</th></tr></thead>
        <tbody>
        @foreach (var l in Model.LignesMateriaux)
        {
            <tr>
                <td class="fw-semibold">@l.Materiau</td><td>@l.Unite</td>
                <td class="text-end">@l.QuantiteUtilisee.ToString("N2")</td>
                <td class="text-end">@l.StockInitial.ToString("N2")</td>
                <td class="text-end">@l.Entree.ToString("N2")</td>
                <td class="text-end">@l.StockRestant.ToString("N2")</td>
                <td class="small text-muted">@l.Observations</td>
            </tr>
        }
        @if (!Model.LignesMateriaux.Any()) { <tr><td colspan="7" class="text-muted text-center">Aucune ligne.</td></tr> }
        </tbody>
    </table>
</div>

<div class="etam-card p-4 mb-3">
    <h6 class="fw-bold">5. Matériels et équipements</h6>
    <table class="table table-sm align-middle">
        <thead><tr><th>Équipement</th><th>État</th><th>Observation</th></tr></thead>
        <tbody>
        @foreach (var l in Model.LignesEquipements)
        {
            <tr><td class="fw-semibold">@l.Equipement</td><td>@l.Etat</td><td class="small text-muted">@l.Observation</td></tr>
        }
        @if (!Model.LignesEquipements.Any()) { <tr><td colspan="3" class="text-muted text-center">Aucune ligne.</td></tr> }
        </tbody>
    </table>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="etam-card p-4 h-100">
            <h6 class="fw-bold">6. Problèmes rencontrés</h6>
            <p class="mb-0" style="white-space:pre-wrap">@Model.ProblemesRencontres</p>
        </div>
    </div>
    <div class="col-md-6">
        <div class="etam-card p-4 h-100">
            <h6 class="fw-bold">7. Suggestions</h6>
            <p class="mb-0" style="white-space:pre-wrap">@Model.Suggestions</p>
        </div>
    </div>
</div>

@if (Model.Statut == StatutRapportTravail.Soumis && User.IsInRole("Administrateur"))
{
    <div class="modal fade" id="modalRefus" tabindex="-1">
        <div class="modal-dialog">
            <form asp-action="Refuser" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-content">
                    <div class="modal-header"><h5 class="modal-title">Refuser le rapport</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                    <div class="modal-body">
                        <label class="form-label">Motif du refus</label>
                        <textarea name="motif" class="form-control" rows="3" required></textarea>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Annuler</button>
                        <button type="submit" class="btn btn-danger">Refuser</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
<script>
  document.querySelectorAll('.js-confirm').forEach(f=>{
    f.addEventListener('submit',e=>{
      e.preventDefault();
      Swal.fire({title:'Confirmer ?',icon:'question',showCancelButton:true,
        confirmButtonText:'Oui',cancelButtonText:'Annuler',confirmButtonColor:'#2563eb'})
        .then(r=>{ if(r.isConfirmed) f.submit(); });
    });
  });
</script>
}
