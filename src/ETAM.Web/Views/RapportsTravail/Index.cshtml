@model List<ETAM.Domain.Entities.RapportTravail>
@using ETAM.Domain.Enums
@{ ViewData["Title"] = "Rapport de travail"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">@Model.Count rapport(s) hebdomadaire(s) d'avancement</p>
    @if (User.IsInRole("Administrateur") || User.IsInRole("Correspondant"))
    {
        <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-plus me-1"></i> Nouveau rapport de travail</a>
    }
</div>
<div class="etam-card p-3">
<table class="table table-hover align-middle datatable">
    <thead><tr>
        <th>N°</th><th>Chantier</th><th>Période</th><th>Statut</th><th></th>
    </tr></thead>
    <tbody>
    @foreach (var r in Model)
    {
        var badge = r.Statut switch {
            StatutRapportTravail.Brouillon => "bg-secondary",
            StatutRapportTravail.Soumis => "bg-info text-dark",
            StatutRapportTravail.Valide => "bg-success",
            StatutRapportTravail.Refuse => "bg-danger",
            _ => "bg-secondary" };
        <tr>
            <td class="fw-semibold">n°@r.Numero</td>
            <td>@r.Chantier?.Nom</td>
            <td class="small">@r.PeriodeDebut.ToString("dd/MM/yyyy") — @r.PeriodeFin.ToString("dd/MM/yyyy")</td>
            <td><span class="badge badge-statut @badge">@r.Statut</span></td>
            <td class="text-end text-nowrap">
                @if (r.EstModifiable && (User.IsInRole("Administrateur") || User.IsInRole("Correspondant")))
                {
                    <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-light"><i class="fa-solid fa-pen me-1"></i> Modifier</a>
                }
                <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-light"><i class="fa-solid fa-eye me-1"></i> Détails</a>
            </td>
        </tr>
    }
    @if (!Model.Any()) { <tr><td colspan="5" class="text-muted text-center">Aucun rapport de travail.</td></tr> }
    </tbody>
</table>
</div>
