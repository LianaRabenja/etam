@{ ViewData["Title"] = ViewData["Module"]?.ToString() ?? "Module"; }
<div class="etam-card p-5 text-center">
    <i class="fa-solid fa-helmet-safety text-primary" style="font-size:2.5rem"></i>
    <h4 class="mt-3 fw-bold">Module « @ViewData["Module"] »</h4>
    <p class="text-muted mb-0">
        Le socle (entités, services, budgets, workflow) est en place.<br/>
        L'interface complète de ce module est livrée à l'itération suivante.
    </p>
</div>
