@using Microsoft.AspNetCore.Identity
@using ETAM.Infrastructure.Identity
@using ETAM.Domain.Interfaces
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject IUnitOfWork Uow
@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string c) => string.Equals(ctrl, c, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    var userName = User.Identity?.Name ?? "Utilisateur";
    var initiales = userName.Length >= 2 ? userName.Substring(0,2).ToUpper() : "ET";
    // Nombre réel d'alertes non lues, affiché en badge sur la cloche de notifications.
    var nbAlertesNonLues = User.Identity?.IsAuthenticated == true
        ? await Uow.Alertes.CountAsync(a => !a.EstLue)
        : 0;
}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · ETAM ERP</title>
    <!-- Préconnexion aux CDN utilisés plus bas : gagne le temps de résolution DNS + poignée de
         main TLS avant même que le navigateur ne rencontre les balises <link>/<script> correspondantes. -->
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link rel="preconnect" href="https://cdn.datatables.net" crossorigin />
    <link rel="preconnect" href="https://code.jquery.com" crossorigin />
    <link rel="dns-prefetch" href="https://cdn.jsdelivr.net" />
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com" />
    <link rel="dns-prefetch" href="https://cdn.datatables.net" />
    <link rel="dns-prefetch" href="https://code.jquery.com" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/etam.css" asp-append-version="true" />
</head>
<body>
<div class="etam-wrapper">
    <!-- Sidebar sombre -->
    <aside class="etam-sidebar" id="etamSidebar">
        <div class="etam-brand">
            <div class="logo">E</div>
            <div>
                <div class="title">ETAM ERP</div>
                <div class="subtitle">Forage &amp; BTP</div>
            </div>
        </div>
        @{
            var isAdmin = User.IsInRole("Administrateur");
            var isRF = User.IsInRole("Correspondant");
            var isChef = User.IsInRole("Chef de chantier");
            var isMagasinier = User.IsInRole("Magasinier");
            // Le bureau : la Direction et la Finance. Elles voient l'argent de bout en bout.
            var estBureau = isAdmin || isRF;
            // Ceux qui suivent la vie d'un chantier au jour le jour, chef compris.
            var suitLeChantier = estBureau || isChef;
            // Le magasin : seul le magasinier et le chef y touchent.
            var voitStock = isAdmin || isChef || isMagasinier;
        }
        @*
            Le menu est volontairement court. Les sept écrans numérotés sont ceux
            du travail quotidien, dans l'ordre exact où on les remplit : on descend,
            on ne saute pas d'étape. Tout le reste est rangé dans le repli du bas.
        *@
        <ul class="etam-nav">

            @if (estBureau) { <li><a class="@Active("Home")" href="/Home/Index"><i class="fa-solid fa-gauge-high"></i> Tableau de bord</a></li> }
            @if (!estBureau) { <li><a href="/Home/Accueil"><i class="fa-solid fa-house"></i> Accueil</a></li> }

            @if (suitLeChantier) { <li class="section">Dans cet ordre</li> }

            @if (estBureau) { <li><a class="@Active("Chantiers")" href="/Chantiers/Index"><i class="fa-solid fa-helmet-safety"></i> <b>1.</b> Chantiers</a></li> }
            @if (estBureau) { <li><a class="@Active("Banques")" href="/Banques/Index"><i class="fa-solid fa-building-columns"></i> <b>2.</b> Banques</a></li> }
            @if (suitLeChantier) { <li><a class="@Active("PrevisionGlobale")" href="/PrevisionGlobale/Index"><i class="fa-solid fa-sitemap"></i> <b>3.</b> Plan du projet</a></li> }
            @if (suitLeChantier) { <li><a class="@Active("PrevisionMensuelle")" href="/PrevisionMensuelle/Index"><i class="fa-solid fa-calendar-days"></i> <b>4.</b> Enveloppe du mois</a></li> }
            @if (suitLeChantier) { <li><a class="@Active("PlanSemaine")" href="/PlanSemaine/Index"><i class="fa-solid fa-table-list"></i> <b>5.</b> Prévision journalière</a></li> }
            @if (suitLeChantier) { <li><a class="@Active("Approvisionnement")" href="/Approvisionnement/Index"><i class="fa-solid fa-cart-flatbed"></i> <b>6.</b> Demande du chantier</a></li> }
            @if (suitLeChantier) { <li><a class="@Active("Prevision")" href="/Prevision/Index"><i class="fa-solid fa-hand-holding-dollar"></i> <b>7.</b> Prévision réelle</a></li> }
            @if (estBureau) { <li><a href="/Prevision/Recap"><i class="fa-solid fa-file-invoice"></i> <b>8.</b> Recap du jour</a></li> }
            @if (suitLeChantier) { <li><a class="@Active("Decaissement")" href="/Decaissement/Index"><i class="fa-solid fa-money-bill-transfer"></i> <b>9.</b> Sorties d'argent</a></li> }
            @if (suitLeChantier) { <li><a class="@Active("RapportsPrevision")" href="/RapportsPrevision/Index"><i class="fa-solid fa-clipboard-check"></i> <b>10.</b> Comptes rendus</a></li> }

            @if (voitStock || estBureau) { <li class="section">Au quotidien</li> }
            @if (voitStock) { <li><a class="@Active("Materiaux")" href="/Materiaux/Index"><i class="fa-solid fa-trowel-bricks"></i> Stock des matériaux</a></li> }
            @if (estBureau) { <li><a href="/Alertes/Index"><i class="fa-solid fa-bell"></i> Alertes</a></li> }
        </ul>

        @* Tout ce qui ne sert pas tous les jours : replié par défaut. *@
        <details class="etam-nav-plus">
            <summary style="list-style:none;cursor:pointer;padding:10px 18px;font-size:.78rem;
                            text-transform:uppercase;letter-spacing:.08em;opacity:.65;">
                <i class="fa-solid fa-ellipsis me-1"></i> Réglages et suivi
            </summary>
            <ul class="etam-nav">
                @if (estBureau) { <li><a class="@Active("Catalogue")" href="/Catalogue/Index"><i class="fa-solid fa-list-check"></i> Catalogue des prix</a></li> }
                @if (isAdmin) { <li><a class="@Active("Fournisseurs")" href="/Fournisseurs/Index"><i class="fa-solid fa-truck-field"></i> Fournisseurs</a></li> }
                @if (isAdmin) { <li><a class="@Active("Dettes")" href="/Dettes/Index"><i class="fa-solid fa-file-invoice-dollar"></i> Dettes fournisseurs</a></li> }
                @if (isAdmin) { <li><a href="/Utilisateurs/Index"><i class="fa-solid fa-users"></i> Utilisateurs</a></li> }
                @if (suitLeChantier) { <li><a class="@Active("RapportsTravail")" href="/RapportsTravail/Index"><i class="fa-solid fa-file-signature"></i> Rapports de travail</a></li> }
                @if (isAdmin) { <li><a href="/BudgetComptes/Index"><i class="fa-solid fa-wallet"></i> Budget du bureau</a></li> }
                @if (isAdmin) { <li><a href="/BudgetMateriel/Index"><i class="fa-solid fa-boxes-stacked"></i> Budget matériel</a></li> }
                @if (isAdmin) { <li><a href="/Depenses/Index"><i class="fa-solid fa-receipt"></i> Journal des dépenses</a></li> }
                @if (estBureau) { <li><a href="/Rapports/Index"><i class="fa-solid fa-chart-pie"></i> Rapports et statistiques</a></li> }
                @if (isAdmin) { <li><a href="/Audit/Index"><i class="fa-solid fa-clipboard-list"></i> Journal d'audit</a></li> }
                @if (isAdmin) { <li><a href="/Parametres/Index"><i class="fa-solid fa-gear"></i> Paramètres</a></li> }
            </ul>
        </details>
    </aside>

    <!-- Zone principale -->
    <div class="etam-main">
        <header class="etam-header">
            <div class="d-flex align-items-center gap-3">
                <button class="etam-toggle" onclick="document.getElementById('etamSidebar').classList.toggle('open')">
                    <i class="fa-solid fa-bars"></i>
                </button>
                <h1 class="page-title">@ViewData["Title"]</h1>
            </div>
            <div class="actions">
                <a href="/Alertes/Index" class="etam-badge-alert position-relative" title="@nbAlertesNonLues alerte(s) non lue(s)">
                    <i class="fa-solid fa-bell"></i>
                    <span id="badgeNotifCount" class="position-absolute badge rounded-pill bg-danger"
                          style="top:-4px;right:-6px;font-size:.65rem; @(nbAlertesNonLues > 0 ? "" : "display:none;")">
                        @(nbAlertesNonLues > 99 ? "99+" : nbAlertesNonLues.ToString())
                    </span>
                </a>
                <div class="etam-user">
                    <div class="etam-avatar">@initiales</div>
                    <div class="d-none d-md-block">
                        <div style="font-weight:600;font-size:.85rem">@userName</div>
                        <div style="font-size:.7rem;color:var(--etam-muted)">ETAM</div>
                    </div>
                    <a href="/Account/ChangePassword" class="btn btn-sm btn-light" title="Changer mon mot de passe">
                        <i class="fa-solid fa-key"></i>
                    </a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-light" title="Déconnexion">
                            <i class="fa-solid fa-arrow-right-from-bracket"></i>
                        </button>
                    </form>
                </div>
            </div>
        </header>

        <main class="etam-content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]
                    <button class="btn-close" data-bs-dismiss="alert"></button></div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]
                    <button class="btn-close" data-bs-dismiss="alert"></button></div>
            }
            @RenderBody()
        </main>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  // Empêche l'alerte bloquante « Incorrect column count » de DataTables
  // (qui faisait apparaître les tableaux comme "cassés").
  if (window.jQuery && $.fn.dataTable) { $.fn.dataTable.ext.errMode = 'none'; }

  // ---- Tri des dates au format francais -------------------------------------
  // DataTables compare les cellules comme du texte : « 01/09/2026 » passait donc
  // AVANT « 15/07/2026 », parce que « 0 » vient avant « 1 ». Les dates paraissaient
  // melangees. On declare ici un type de colonne « date-fr » qui trie sur la date
  // reelle. Declare une seule fois, il s'applique a tous les tableaux du site.
  if (window.jQuery && $.fn.dataTable) {
    var reDateFr = /^\s*(\d{1,2})\/(\d{1,2})\/(\d{4})(?:[\s,]+(\d{1,2})[:h](\d{2}))?\s*$/;

    $.fn.dataTable.ext.type.detect.unshift(function(d){
      if (d === null || d === undefined) return null;
      var s = String(d).trim();
      // Les cellules vides ne doivent pas faire retomber la colonne en tri texte.
      if (s === '' || s === '-' || s === '—') return 'date-fr';
      return reDateFr.test(s) ? 'date-fr' : null;
    });

    $.fn.dataTable.ext.type.order['date-fr-pre'] = function(d){
      var m = reDateFr.exec(String(d == null ? '' : d).trim());
      if (!m) return 0;   // vide : trie avant tout le reste
      return new Date(+m[3], +m[2] - 1, +m[1], +(m[4] || 0), +(m[5] || 0)).getTime();
    };
  }

  $(function(){
    // Chaque tableau est initialisé indépendamment : si l'un pose problème,
    // les autres restent fonctionnels. scrollX évite que les grands tableaux
    // débordent de l'écran (ils défilent horizontalement à la place).
    $('.datatable').each(function(){
      try{
        $(this).DataTable({
          language:{ url:'https://cdn.datatables.net/plug-ins/1.13.8/i18n/fr-FR.json' },
          pageLength:10, order:[], autoWidth:false, scrollX:true
        });
      }catch(e){ console.warn('Tableau non trié (structure particulière) :', e); }
    });
  });

  // Met à jour le badge de notifications dans l'en-tête (appelé après un "marquer comme lue" en AJAX).
  window.etamSetBadgeNotif = function(n){
    var el = document.getElementById('badgeNotifCount');
    if(!el) return;
    if(n > 0){
      el.style.display = '';
      el.textContent = n > 99 ? '99+' : n;
    } else {
      el.style.display = 'none';
      el.textContent = '0';
    }
  };
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
