@model ETAM.Infrastructure.Identity.ApplicationUser
@{ ViewData["Title"] = "Gérer le rôle"; var roles = ViewBag.Roles as string[] ?? Array.Empty<string>(); var actuel = ViewBag.RoleActuel as string; }
<div class="etam-card p-4" style="max-width:520px">
    <h6 class="fw-bold">@Model.NomComplet</h6>
    <p class="text-muted small">@Model.Email · Rôle actuel : <strong>@(actuel ?? "aucun")</strong></p>
    <form asp-action="GererRoles" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="mb-3">
            <label class="form-label">Nouveau rôle</label>
            <select name="role" class="form-select">
                @foreach (var r in roles)
                {
                    <option value="@r" selected="@(r == actuel)">@r</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Enregistrer le rôle</button>
        <a asp-action="Index" class="btn btn-light">Annuler</a>
    </form>
</div>
