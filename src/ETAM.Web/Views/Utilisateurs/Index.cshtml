@model List<ETAM.Infrastructure.Identity.ApplicationUser>
@{ ViewData["Title"] = "Utilisateurs"; var roles = ViewBag.Roles as Dictionary<string,string> ?? new();
   var chantiers = ViewBag.NomsChantiers as Dictionary<long,string> ?? new(); }
<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted mb-0">@Model.Count utilisateur(s).</p>
    <a asp-action="Create" class="btn btn-primary"><i class="fa-solid fa-user-plus me-1"></i> Nouvel utilisateur</a>
</div>
<div class="etam-card p-3">
<table class="table table-hover align-middle datatable">
    <thead><tr><th>Nom</th><th>Email</th><th>Fonction</th><th>Rôle(s)</th><th>Chantier</th><th>Statut</th><th></th></tr></thead>
    <tbody>
    @foreach (var u in Model)
    {
        <tr>
            <td class="fw-semibold">@u.NomComplet</td>
            <td>@u.Email</td>
            <td class="small text-muted">@u.Fonction</td>
            <td class="small">@(roles.TryGetValue(u.Id, out var r) ? r : "")</td>
            <td class="small">
                @if (chantiers.TryGetValue(u.ChantierId ?? 0, out var nomChantier))
                {
                    <span>@nomChantier</span>
                }
                else
                {
                    <span class="text-muted">tous</span>
                }
            </td>
            <td>
                @if (u.EstActif) { <span class="badge bg-success">Actif</span> }
                else { <span class="badge bg-secondary">Désactivé</span> }
            </td>
            <td class="text-end text-nowrap">
                <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-light"><i class="fa-solid fa-pen me-1"></i> Modifier</a>
                <form asp-action="BasculerActivation" method="post" class="d-inline">
                    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@u.Id" />
                    <button class="btn btn-sm btn-light">@(u.EstActif ? "Désactiver" : "Activer")</button></form>
                <form asp-action="Supprimer" method="post" class="d-inline js-confirm-suppr">
                    @Html.AntiForgeryToken()<input type="hidden" name="id" value="@u.Id" />
                    <button class="btn btn-sm btn-outline-danger" title="Supprimer définitivement">
                        <i class="fa-solid fa-trash"></i>
                    </button></form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>

@section Scripts {
<script>
  // Une suppression de compte ne se fait pas par inadvertance.
  document.querySelectorAll('.js-confirm-suppr').forEach(f => {
    f.addEventListener('submit', e => {
      e.preventDefault();
      Swal.fire({
        title: 'Supprimer ce compte ?',
        text: "Cette action est définitive.",
        icon: 'warning', showCancelButton: true,
        confirmButtonText: 'Supprimer', cancelButtonText: 'Annuler',
        confirmButtonColor: '#dc2626'
      }).then(r => { if (r.isConfirmed) f.submit(); });
    });
  });
</script>
}
